// Release.xcconfig
// Release configuration for macOS projects - minimal overrides only
// Generated by XcodeBuildMCP

#include "Shared.xcconfig"
INFOPLIST_FILE = Resources/Configs/App-Info.plist

// Direct distribution. Developer ID identity is supplied at packaging time.
ENABLE_HARDENED_RUNTIME = YES
SWIFT_OPTIMIZATION_LEVEL = -O

// Sparkle's update-signing public key. Public by design: it only lets the app verify
// updates. The private half lives only in the release Mac's keychain, under
// `generate_keys --account cascade`. Cascade's own key, never Cascade's: Cascade's installs update
// from cascade-mac's feed. Never put `//` in a value here: it starts a comment.
CASCADE_UPDATE_PUBLIC_KEY = 6sg6zpE/9SjFBOouJDbaYdllH4rcPIn2PXhkPP3ybac=
