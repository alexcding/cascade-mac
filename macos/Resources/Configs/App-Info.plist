<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CascadeBuildConfiguration</key>
    <string>$(CONFIGURATION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.alexcding.cascade.navigation</string>
            <key>CFBundleURLSchemes</key>
            <array><string>cascade</string></array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>
    <!-- Help → Cascade Help opens Cascade.help in Help Viewer. The name is the help book's own
         CFBundleIdentifier. -->
    <key>CFBundleHelpBookFolder</key>
    <string>Cascade.help</string>
    <key>CFBundleHelpBookName</key>
    <string>com.alexcding.cascade.help</string>
    <!-- The browser panel opens whatever address is typed, including plain http sites and dev
         servers. Scoped to web views and local hosts: the app's own URLSession traffic stays
         https-only. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Terminal sessions and the agents they run inherit Cascade's microphone grant: macOS
         attributes a child process's audio input to the responsible app, and without this key
         the request is refused outright instead of prompting. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Cascade needs the microphone so voice input works in terminal sessions and agents you run here.</string>
    <!-- Empty values leave Sparkle inactive. Release builds supply the real feed
         and public key through build settings; private keys never enter the app. -->
    <key>SUFeedURL</key>
    <string>$(CASCADE_UPDATE_FEED_URL)</string>
    <key>SUPublicEDKey</key>
    <string>$(CASCADE_UPDATE_PUBLIC_KEY)</string>
</dict>
</plist>
