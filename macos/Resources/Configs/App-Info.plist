<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CascadeBuildConfiguration</key>
    <string>$(CONFIGURATION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.alexcding.cascade.navigation</string>
            <key>CFBundleURLSchemes</key>
            <array><string>cascade</string></array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>
    <!-- Help → Detailed User Guide (English) opens Cascade.help in Help Viewer. The name is the help book's own
         CFBundleIdentifier. -->
    <key>CFBundleHelpBookFolder</key>
    <string>Cascade.help</string>
    <key>CFBundleHelpBookName</key>
    <string>com.alexcding.cascade.help</string>
    <!-- The browser panel opens whatever address is typed, including plain http sites and dev
         servers. Scoped to web views and local hosts: the app's own URLSession traffic stays
         https-only. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoadsInWebContent</key>
        <true/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- Web pages in the browser panel, terminal sessions and the agents they run use the
         microphone and camera under Cascade's grant: macOS attributes a child process's capture
         to the responsible app, and without these keys the request is refused outright instead
         of prompting. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Cascade needs the microphone so web pages, terminal sessions and agents you run here can use it.</string>
    <key>NSCameraUsageDescription</key>
    <string>Cascade needs the camera so web pages, terminal sessions and agents you run here can use it.</string>
    <!-- Scripts and agents in a terminal session send Apple Events as Cascade; web pages cannot. -->
    <key>NSAppleEventsUsageDescription</key>
    <string>Cascade needs to control other apps when scripts or agents you run in its terminal sessions ask to.</string>
    <!-- Since macOS 15, reaching a device on the local network (a dev server on another Mac, a
         phone) asks first; the prompt shows this text. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Cascade needs the local network to reach dev servers and devices from the browser panel and terminal sessions.</string>
    <!-- Empty values leave Sparkle inactive. Release builds supply the real feed
         and public key through build settings; private keys never enter the app. -->
    <key>SUFeedURL</key>
    <string>$(CASCADE_UPDATE_FEED_URL)</string>
    <key>SUPublicEDKey</key>
    <string>$(CASCADE_UPDATE_PUBLIC_KEY)</string>
</dict>
</plist>
