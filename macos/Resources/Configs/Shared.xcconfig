// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = Cascade
PRODUCT_DISPLAY_NAME = Cascade
PRODUCT_BUNDLE_IDENTIFIER = com.alexcding.cascade
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
MACOSX_DEPLOYMENT_TARGET = 14.0

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Resources/Configs/Cascade.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Resources/Configs/Cascade.entitlements
CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual
ENABLE_APP_SANDBOX = NO
SWIFT_VERSION = 6.0
ALWAYS_SEARCH_USER_PATHS = NO
// Embedded dynamic frameworks (Sparkle) must resolve in standalone app launches.
LD_RUNPATH_SEARCH_PATHS = $(inherited) @loader_path/../Frameworks

// The Rust backend's C ABI (Vendor/CascadeBackend, from crates/cascade-backend/src/ffi.rs).
// The targets that compile the app sources (app, unit tests, terminal stress) link
// libcascade_backend.a through their own settings in the project.
SWIFT_INCLUDE_PATHS = $(inherited) $(PROJECT_DIR)/Vendor/CascadeBackend
