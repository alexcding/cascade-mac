          "stringUnit": {
            "state": "translated",
            "value": "अपस्ट्रीम से %lld कमिट पीछे है। पुश के लिए ब्रांच अपडेट करनी पड़ सकती है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld commits de retraso respecto al remoto. Puede ser necesario actualizar la rama antes de enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retard de %lld commits sur l’amont. Il faudra peut-être mettre à jour la branche avant l’envoi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপস্ট্রিমের থেকে %lld কমিট পিছিয়ে। পুশ করতে ব্রাঞ্চ আপডেট লাগতে পারে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há %lld commits de atraso em relação ao upstream. Talvez seja preciso atualizar a branch antes do push."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отставание от upstream: %lld коммитов. Перед отправкой может потребоваться обновление ветки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップストリームより %lld コミット遅れています。プッシュ前にブランチの更新が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업스트림보다 %lld개 커밋 뒤처져 있습니다. 푸시하려면 브랜치 업데이트가 필요할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligger %lld incheckningar efter upstream. Grenen kan behöva uppdateras före push."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ramo è indietro di %lld commit rispetto all’upstream. Potrebbe essere necessario aggiornarlo prima del push."
          }
        }
      }
    },
