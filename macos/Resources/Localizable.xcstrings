            "state": "translated",
            "value": "Questa pagina ha già un’operazione di sessione attiva. Apri la relativa sessione per continuare."
          }
        }
      }
    },
    "Wait for the Git operation to finish before removing this worktree.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
