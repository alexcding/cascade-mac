    "Sets the Jira project for Tickets and Sprint Board. Use a filter clause, such as %@, to narrow results.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置工单和冲刺看板使用的 Jira 项目。使用筛选子句（如 %@）缩小结果范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定議題和衝刺看板使用的 Jira 專案。使用篩選子句（如 %@）縮小結果範圍。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टिकट और स्प्रिंट बोर्ड के लिए Jira प्रोजेक्ट सेट करता है। नतीजे सीमित करने के लिए %@ जैसा फ़िल्टर क्लॉज़ उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el proyecto Jira de Tickets y Tablero del sprint. Usa una cláusula de filtro, como %@, para limitar los resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le projet Jira pour Tickets et Tableau du sprint. Utilisez une clause de filtre, comme %@, pour affiner les résultats."
