    "Simulator preview needs Node.js 20 or later in your terminal. Cascade downloads its preview tool automatically when first used.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模拟器预览需要终端中可用的 Node.js 20 或更高版本。Cascade 会在首次使用时自动下载预览工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬器預覽需要終端機中可用的 Node.js 20 或以上版本。Cascade 會在首次使用時自動下載預覽工具。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिम्युलेटर प्रीव्यू के लिए टर्मिनल में Node.js 20 या नया संस्करण चाहिए। Cascade पहली बार इस्तेमाल पर प्रीव्यू टूल अपने-आप डाउनलोड करता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa del simulador necesita Node.js 20 o posterior en tu terminal. Cascade descarga la herramienta de vista previa automáticamente al usarla por primera vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu du simulateur nécessite Node.js 20 ou ultérieur dans votre terminal. Cascade télécharge automatiquement l’outil d’aperçu à la première utilisation."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিমুলেটর প্রিভিউয়ের জন্য টার্মিনালে Node.js 20 বা পরের সংস্করণ দরকার। প্রথম ব্যবহারে Cascade নিজে থেকেই প্রিভিউ টুল ডাউনলোড করে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prévia do simulador precisa do Node.js 20 ou posterior no terminal. O Cascade baixa a ferramenta de prévia automaticamente no primeiro uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для предпросмотра симулятора нужен Node.js 20 или новее в терминале. Cascade автоматически загружает инструмент предпросмотра при первом использовании."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータのプレビューには、ターミナルで使える Node.js 20 以降が必要です。プレビュー用ツールは初回使用時に Cascade が自動でダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이터 미리 보기에는 터미널에서 사용할 수 있는 Node.js 20 이상이 필요합니다. Cascade가 처음 사용할 때 미리 보기 도구를 자동으로 다운로드합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulatorförhandsvisningen kräver Node.js 20 eller senare i terminalen. Cascade hämtar förhandsvisningsverktyget automatiskt vid första användningen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anteprima del simulatore richiede Node.js 20 o successivo nel terminale. Cascade scarica automaticamente lo strumento di anteprima al primo utilizzo."
          }
        }
      }
    },
