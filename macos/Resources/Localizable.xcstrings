    "The agent forgets everything said so far. The worktree is not touched.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理将忘记此前的全部对话。工作树不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式將忘記先前的全部對話。工作樹不受影響。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट अब तक की सारी बातचीत भूल जाएगा। वर्कट्री नहीं बदलेगी।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente olvida todo lo hablado. El árbol de trabajo no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent oublie toute la conversation. L’arbre de travail n’est pas modifié."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট এ পর্যন্ত সব কথা ভুলে যাবে। ওয়ার্কট্রি বদলাবে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente esquece toda a conversa. A árvore de trabalho não é alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент забудет весь разговор. Рабочее дерево не изменится."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこれまでの会話をすべて忘れます。ワークツリーは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 지금까지의 대화를 모두 잊습니다. 작업 트리는 변경되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten glömmer allt som sagts. Arbetsträdet påverkas inte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente dimentica tutta la conversazione. L’albero di lavoro non viene modificato."
          }
        }
      }
    },
