    "The terminal snapshot appearance does not match its response owner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端快照外观与其响应控制方不匹配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機快照外觀與其回應控制方不符。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल स्नैपशॉट का रूप उसके प्रतिक्रिया स्वामी से मेल नहीं खाता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia de la instantánea no coincide con su responsable de respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence de l’instantané ne correspond pas au responsable des réponses."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনাল স্ন্যাপশটের চেহারা তার প্রতিক্রিয়া নিয়ন্ত্রকের সঙ্গে মেলে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência do instantâneo não corresponde ao responsável pelas respostas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление снимка терминала не соответствует владельцу ответов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルスナップショットの外観が応答の管理元と一致しません。"
