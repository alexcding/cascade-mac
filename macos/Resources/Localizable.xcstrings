    "Chat opens once %@ is ready. Answer anything it asks here first." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ প্রস্তুত হলে চ্যাট খুলবে। আগে এখানে তার প্রশ্নের উত্তর দিন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El chat se abre cuando %@ esté listo. Responde primero aquí a lo que pregunte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chat s’ouvre quand %@ est prêt. Répondez d’abord ici à ses questions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तैयार होने पर चैट खुलेगी। पहले यहाँ उसके सवालों का जवाब दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chat si apre quando %@ è pronto. Rispondi prima qui alle sue domande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の準備ができるとチャットを開けます。まずここで質問に答えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 준비되면 채팅이 열립니다. 먼저 여기에서 질문에 답하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O chat abre quando %@ estiver pronto. Responda primeiro aqui ao que ele perguntar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чат откроется, когда %@ будет готов. Сначала ответьте здесь на его вопросы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatten öppnas när %@ är redo. Besvara först eventuella frågor här."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 准备就绪后即可打开聊天。请先在此回答其问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 準備就緒後即可開啟聊天。請先在此回答其問題。"
          }
        }
      }
    },
