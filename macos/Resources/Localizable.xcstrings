    "The Rust backend executable is missing. Build cascade-backend, pass --backend-path, or use --backend-url.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 Rust 后端可执行文件。请构建 cascade-backend、传入 --backend-path 或使用 --backend-url。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少 Rust 後端執行檔。請建置 cascade-backend、傳入 --backend-path 或使用 --backend-url。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust बैकएंड निष्पादन योग्य फ़ाइल नहीं मिली। cascade-backend बिल्ड करें, --backend-path दें या --backend-url उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el ejecutable del backend Rust. Compila cascade-backend, indica --backend-path o usa --backend-url."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exécutable du backend Rust est manquant. Compilez cascade-backend, passez --backend-path ou utilisez --backend-url."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust ব্যাকএন্ড এক্সিকিউটেবল নেই। cascade-backend বিল্ড করুন, --backend-path দিন বা --backend-url ব্যবহার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
