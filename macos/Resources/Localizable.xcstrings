    "The existing worktree changed. Resolve the page again before creating the session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有工作树已更改。请重新解析页面后再创建会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現有工作樹已變更。請重新解析頁面後再建立工作階段。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा वर्कट्री बदल गई। सत्र बनाने से पहले पेज फिर देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El árbol de trabajo existente cambió. Vuelve a resolver la página antes de crear la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arbre de travail a changé. Résolvez à nouveau la page avant de créer la session."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিদ্যমান ওয়ার্কট্রি বদলেছে। সেশন তৈরির আগে পৃষ্ঠা আবার যাচাই করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A árvore de trabalho existente mudou. Resolva a página novamente antes de criar a sessão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующее рабочее дерево изменилось. Повторно определите страницу перед созданием сеанса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のワークツリーが変わりました。セッション作成前にページを再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 작업 트리가 변경되었습니다. 세션을 만들기 전에 페이지를 다시 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
