    "‘%@’ is not a VS Code Marketplace or Open VSX link, or an extension ID like publisher.name." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ কোনো VS Code Marketplace বা Open VSX লিংক নয়, এমনকি publisher.name ধরনের এক্সটেনশন ID-ও নয়।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un enlace de VS Code Marketplace u Open VSX, ni un ID de extensión como publisher.name."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n’est ni un lien VS Code Marketplace ou Open VSX, ni un ID d’extension comme publisher.name."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ VS Code Marketplace या Open VSX लिंक नहीं है, और publisher.name जैसा एक्सटेंशन ID भी नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» non è un link di VS Code Marketplace o Open VSX, né un ID di estensione come publisher.name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は VS Code Marketplace や Open VSX のリンクでも、publisher.name のような拡張機能 ID でもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) VS Code Marketplace 또는 Open VSX 링크도, publisher.name 같은 확장 프로그램 ID도 아닙니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não é um link do VS Code Marketplace ou do Open VSX, nem um ID de extensão como publisher.name."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» — это не ссылка на VS Code Marketplace или Open VSX и не ID расширения вида publisher.name."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” är varken en länk till VS Code Marketplace eller Open VSX eller ett tilläggs-ID som publisher.name."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
