            "value": "O checkout principal foi movido para %@, mas a árvore de trabalho não pôde ser criada: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основная рабочая копия переключена на %@, но создать рабочее дерево не удалось: %@"
          }
