    "Worktree created at %@, but the session could not be saved: %@. Use this branch again to recover it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এ ওয়ার্কট্রি তৈরি হয়েছে, কিন্তু সেশন সংরক্ষণ হয়নি: %@। ফেরাতে এই ব্রাঞ্চ আবার ব্যবহার করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Árbol de trabajo creado en %@, pero no se pudo guardar la sesión: %@. Usa de nuevo esta rama para recuperarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbre de travail créé à %@, mais la session n’a pas pu être enregistrée : %@. Réutilisez cette branche pour la récupérer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर वर्कट्री बनी, लेकिन सत्र नहीं सहेजा गया: %@। बहाल करने के लिए यही ब्रांच फिर इस्तेमाल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albero di lavoro creato in %@, ma impossibile salvare la sessione: %@. Usa di nuovo questo ramo per recuperarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にワークツリーを作成しましたが、セッションを保存できませんでした：%@。このブランチを再度使用すると復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 작업 트리를 만들었지만 세션을 저장할 수 없습니다: %@. 복구하려면 이 브랜치를 다시 사용하세요."
