        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-কে জিজ্ঞেস করুন, কমান্ডের জন্য /, ফাইলের জন্য @"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte a %@, / para comandos, @ para arquivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спросите %@, / — команды, @ — файлы"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に質問、/ でコマンド、@ でファイル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에게 질문하세요. /는 명령, @는 파일"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fråga %@ vad som helst, / för kommandon, @ för filer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a %@, / per i comandi, @ per i file"
          }
        }
      }
    },
    "Attach files to your message. Remove a file’s chip to detach it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件附加到消息。删除文件标签即可移除附件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案附加到訊息。刪除檔案標籤即可移除附件。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदेश में फ़ाइलें जोड़ें। हटाने के लिए फ़ाइल का चिप मिटाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta archivos al mensaje. Elimina la ficha de un archivo para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez des fichiers au message. Retirez l’étiquette d’un fichier pour le détacher."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তায় ফাইল যুক্ত করুন। ফাইলের চিপ সরিয়ে সংযুক্তি বাদ দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe arquivos à mensagem. Remova o marcador de um arquivo para desanexá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите файлы к сообщению. Удалите метку файла, чтобы убрать вложение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージにファイルを添付します。ファイルのチップを削除すると添付を解除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지에 파일을 첨부합니다. 파일 칩을 삭제하면 첨부가 해제됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifoga filer till meddelandet. Ta bort filens etikett för att ta bort bilagan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega file al messaggio. Rimuovi l’etichetta di un file per scollegarlo."
          }
        }
      }
    },
