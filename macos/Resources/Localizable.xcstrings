    "The terminal stops and this folder is deleted. Your branch and its commits stay, but anything not committed here is lost.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端将停止，此文件夹将被删除。分支及其提交会保留，但此处未提交的内容将丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機將停止，此資料夾將被刪除。分支及其提交會保留，但此處未提交的內容將遺失。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल रुक जाएगा और यह फ़ोल्डर मिट जाएगा। ब्रांच और उसके कमिट रहेंगे, लेकिन यहाँ बिना कमिट का काम खो जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detiene la terminal y se elimina esta carpeta. La rama y sus commits se conservan, pero se pierde todo lo no confirmado aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal s’arrête et ce dossier est supprimé. La branche et ses commits restent, mais le travail non commité ici est perdu."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনাল থামবে এবং এই ফোল্ডার মুছবে। ব্রাঞ্চ ও তার কমিট থাকবে, কিন্তু এখানে কমিট না করা সব কাজ হারাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal para e esta pasta é excluída. A branch e seus commits ficam, mas tudo que não foi commitado aqui é perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Терминал остановится, папка будет удалена. Ветка и коммиты сохранятся, но незакоммиченные изменения будут потеряны."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルを停止し、このフォルダを削除します。ブランチとコミットは残りますが、未コミットの内容は失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널이 중지되고 이 폴더가 삭제됩니다. 브랜치와 커밋은 유지되지만 커밋하지 않은 내용은 사라집니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalen stoppas och mappen raderas. Grenen och dess incheckningar finns kvar, men allt som inte checkats in går förlorat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale si ferma e la cartella viene eliminata. Il ramo e i commit restano, ma il lavoro non salvato in un commit va perso."
          }
        }
      }
    },
    "%lld sessions use this folder, so all of them go: %@.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个会话使用此文件夹，因此将全部移除：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個工作階段使用此資料夾，因此將全部移除：%@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld सत्र यह फ़ोल्डर इस्तेमाल करते हैं, इसलिए सभी हटेंगे: %@।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sesiones usan esta carpeta y se eliminarán todas: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions utilisent ce dossier et seront toutes supprimées : %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldটি সেশন এই ফোল্ডার ব্যবহার করে, তাই সব সরবে: %@।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessões usam esta pasta e todas serão removidas: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту папку используют %lld сеансов. Все будут удалены: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを使用する %lld 個のセッションをすべて削除します：%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 사용하는 세션 %lld개가 모두 제거됩니다: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessioner använder mappen och alla tas bort: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessioni usano questa cartella e verranno tutte rimosse: %@."
          }
        }
      }
    },
    "Still open in %@. Xcode is asked to close it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在 %@ 中打开。将请求 Xcode 关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍在 %@ 中開啟。將要求 Xcode 關閉。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी %@ में खुला है। Xcode से इसे बंद करने को कहा जाएगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue abierto en %@. Se pedirá a Xcode que lo cierre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours ouvert dans %@. Il sera demandé à Xcode de le fermer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও %@-এ খোলা। Xcode-কে বন্ধ করতে বলা হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda aberto em %@. O Xcode receberá um pedido para fechá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ещё открыто в %@. Xcode получит запрос на закрытие."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で開いたままです。Xcode に終了を要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 아직 열려 있습니다. Xcode에 닫기를 요청합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortfarande öppet i %@. Xcode ombeds stänga det."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora aperto in %@. Verrà chiesto a Xcode di chiuderlo."
          }
        }
      }
    },
    "No project here owns this folder. The terminal stops and Cascade forgets the session — the folder itself stays.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有项目拥有此文件夹。终端将停止，Cascade 将忘记此会话，文件夹本身会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有專案擁有此資料夾。終端機將停止，Cascade 將忘記此工作階段，資料夾本身會保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी प्रोजेक्ट में यह फ़ोल्डर नहीं है। टर्मिनल रुकता है और Cascade सत्र भूलता है; फ़ोल्डर बना रहता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún proyecto es propietario de esta carpeta. La terminal se detiene y Cascade olvida la sesión; la carpeta se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun projet ne possède ce dossier. Le terminal s’arrête et Cascade oublie la session ; le dossier reste."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোল্ডার কোনো প্রকল্পের নয়। টার্মিনাল থামবে এবং Cascade সেশন ভুলবে; ফোল্ডার থাকবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum projeto é dono desta pasta. O terminal para e o Cascade esquece a sessão; a pasta permanece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка не принадлежит ни одному проекту. Терминал остановится, Cascade забудет сеанс, а папка останется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダを所有するプロジェクトはありません。ターミナルを停止し、Cascade からセッションを削除します。フォルダは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더를 소유한 프로젝트가 없습니다. 터미널이 중지되고 Cascade에서 세션이 지워지지만 폴더는 유지됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget projekt äger mappen. Terminalen stoppas och Cascade glömmer sessionen, men mappen behålls."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun progetto possiede questa cartella. Il terminale si ferma e Cascade dimentica la sessione; la cartella resta."
          }
        }
      }
    },
    "Sessions using this worktree changed. Close this dialog and review removal again.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此工作树的会话已更改。请关闭此对话框并重新检查移除操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此工作樹的工作階段已變更。請關閉此對話框並重新檢查移除操作。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस वर्कट्री के सत्र बदल गए। संवाद बंद करके हटाने की फिर समीक्षा करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de este árbol cambiaron. Cierra el diálogo y revisa la eliminación de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions de cet arbre ont changé. Fermez cette boîte de dialogue et réexaminez la suppression."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ওয়ার্কট্রির সেশন বদলেছে। ডায়ালগ বন্ধ করে অপসারণ আবার যাচাই করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões desta árvore mudaram. Feche o diálogo e revise a remoção novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеансы этого рабочего дерева изменились. Закройте диалог и проверьте удаление заново."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークツリーを使用するセッションが変わりました。ダイアログを閉じて削除内容を再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 트리를 사용하는 세션이 변경되었습니다. 대화 상자를 닫고 제거 내용을 다시 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionerna i arbetsträdet har ändrats. Stäng dialogrutan och granska borttagningen igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni di questo albero sono cambiate. Chiudi la finestra e verifica di nuovo la rimozione."
          }
        }
      }
    },
