    "Commits all tracked changes on disk. Save editor buffers first to include them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交磁盘上的所有已跟踪更改。请先保存编辑器中的内容以将其包含在提交中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交磁碟上的所有已追蹤變更。請先儲存編輯器中的內容以將其包含在提交中。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिस्क के सभी ट्रैक किए बदलाव कमिट करता है। संपादक के बदलाव शामिल करने के लिए पहले उन्हें सहेजें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma todos los cambios rastreados en disco. Guarda primero los cambios del editor para incluirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commite toutes les modifications suivies sur disque. Enregistrez d’abord le contenu des éditeurs pour l’inclure."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডিস্কের সব ট্র্যাক করা পরিবর্তন কমিট করে। সম্পাদকের পরিবর্তন অন্তর্ভুক্ত করতে আগে সংরক্ষণ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Commita todas as alterações rastreadas no disco. Salve o conteúdo do editor antes para incluí-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаёт коммит со всеми отслеживаемыми изменениями на диске. Сначала сохраните изменения в редакторе."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク上の追跡対象の変更をすべてコミットします。エディタ内の変更を含めるには先に保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크의 모든 추적된 변경 사항을 커밋합니다. 편집기 내용을 포함하려면 먼저 저장하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkar in alla spårade ändringar på disken. Spara först redigerarens innehåll för att ta med det."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un commit con tutte le modifiche tracciate su disco. Salva prima il contenuto dell’editor per includerlo."
          }
        }
      }
    },
