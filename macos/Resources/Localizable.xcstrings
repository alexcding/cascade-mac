          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidarebefordran av webhookar är avstängd. Automatiseringarna kontrollerar pull request-ändringar enligt det vanliga uppdateringsschemat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’inoltro dei webhook è disattivato. Le automazioni controllano le modifiche alle pull request secondo l’intervallo abituale."
