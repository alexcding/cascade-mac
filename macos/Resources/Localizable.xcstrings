    "Runs in order. Errors stop the following actions unless configured to continue.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序运行。除非设置为继续，否则出错会停止后续操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序執行。除非設定為繼續，否則錯誤會停止後續動作。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम में चलता है। जारी रखने का विकल्प न हो तो त्रुटि पर आगे की कार्रवाइयाँ रुकती हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en orden. Los errores detienen las acciones siguientes salvo que se configure continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute dans l’ordre. Une erreur arrête les actions suivantes sauf si la poursuite est configurée."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্রমে চলে। চালিয়ে যাওয়ার সেটিং না থাকলে ত্রুটিতে পরের কাজ থামে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa em ordem. Erros param as próximas ações, salvo se configurado para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется по порядку. Ошибка останавливает следующие действия, если не настроено продолжение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "順番に実行します。続行設定がなければ、エラーで後続アクションを停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순서대로 실행합니다. 계속하도록 설정하지 않으면 오류 시 후속 동작이 중지됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Körs i ordning. Fel stoppar följande åtgärder om inte fortsättning har valts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegue in ordine. Gli errori fermano le azioni successive salvo configurazione per proseguire."
          }
