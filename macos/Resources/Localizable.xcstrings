    "Upper bounds on the change size. Leave a bound empty to ignore it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更规模上限。留空则忽略该项限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更規模上限。留空則忽略該項限制。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव के आकार की ऊपरी सीमा। सीमा अनदेखी करने के लिए खाली रखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límites de tamaño del cambio. Deja un límite vacío para ignorarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limites de taille des modifications. Laissez une limite vide pour l’ignorer."
