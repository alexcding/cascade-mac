          "stringUnit": {
            "state": "translated",
            "value": "尚未設定版本更新來源。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिलीज़ अपडेट फ़ीड कॉन्फ़िगर नहीं की गई है।"
