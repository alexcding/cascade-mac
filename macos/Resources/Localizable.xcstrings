            "value": "已拒絕不屬於目前使用者或並非通訊端的終端機端點。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा टर्मिनल एंडपॉइंट अस्वीकार किया जो अपना नहीं है या सॉकेट नहीं है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechaza un punto de conexión ajeno o que no es un socket."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point de connexion refusé : il ne vous appartient pas ou n’est pas un socket."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যবহারকারীর মালিকানাহীন বা সকেট নয় এমন টার্মিনাল প্রান্ত প্রত্যাখ্যাত।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto de conexão recusado: não pertence ao usuário ou não é um socket."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклонена конечная точка терминала: чужой владелец или не сокет."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "所有していない、またはソケットではないターミナル接続先を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소유하지 않거나 소켓이 아닌 터미널 엔드포인트를 거부했습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisar en terminaländpunkt som inte ägs av användaren eller inte är en socket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint del terminale rifiutato: non appartiene all’utente o non è un socket."
          }
        }
      }
    },
    "Session processes did not stop. The worktree has been kept; retry the operation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话进程未停止。工作树已保留，请重试操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段程序未停止。工作樹已保留，請重試操作。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र प्रक्रियाएँ नहीं रुकीं। वर्कट्री सुरक्षित है; क्रिया फिर आज़माएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los procesos de la sesión no se detuvieron. Se conservó el árbol de trabajo; reintenta la operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les processus de session ne se sont pas arrêtés. L’arbre de travail est conservé ; réessayez l’opération."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেশনের প্রক্রিয়া থামেনি। ওয়ার্কট্রি রাখা হয়েছে; আবার চেষ্টা করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os processos da sessão não pararam. A árvore de trabalho foi mantida; tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Процессы сеанса не остановились. Рабочее дерево сохранено; повторите операцию."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションのプロセスが停止しませんでした。ワークツリーは保持されています。操作を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 프로세스가 중지되지 않았습니다. 워크트리는 유지되었으니 작업을 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessionsprocesserna stoppades inte. Arbetsträdet har behållits; försök igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I processi della sessione non si sono fermati. L’albero di lavoro è conservato; riprova."
          }
        }
      }
    },
    "Snapshot appearance requires native geometry ownership.": {
      "localizations": {
        "zh-Hans": {
