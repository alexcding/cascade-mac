            "value" : "আপনার বুকমার্ক করা বা দেখা পৃষ্ঠা এবং খোলা ফাইল এখানে দেখা যাবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las páginas que guardas en marcadores o visitas y los archivos que abres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages que vous ajoutez aux signets ou visitez, et les fichiers que vous ouvrez, s’affichent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके बुकमार्क किए या देखे गए पेज और खोली गई फ़ाइलें यहाँ दिखती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono le pagine che aggiungi ai preferiti o visiti e i file che apri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブックマークしたページや訪れたページ、開いたファイルがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "북마크했거나 방문한 페이지와 연 파일이 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas que você salva nos favoritos ou visita e os arquivos que abre aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
