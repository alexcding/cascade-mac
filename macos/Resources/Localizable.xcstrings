            "state": "translated",
            "value": "Det här skalet har en inkompatibel utseendeansvarig. Det befintliga skalet har behållits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa shell ha un responsabile dell’aspetto incompatibile. La shell esistente è conservata."
