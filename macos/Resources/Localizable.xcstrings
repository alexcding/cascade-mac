    "Webhook forwarding is off. Automations check pull request changes on the regular refresh schedule." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওয়েবহুক পাঠানো বন্ধ। অটোমেশন নিয়মিত রিফ্রেশের সময়সূচি অনুযায়ী পুল রিকোয়েস্টের পরিবর্তন দেখে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reenvío de webhooks está desactivado. Las automatizaciones comprueban los cambios de solicitudes con la frecuencia habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le transfert des webhooks est désactivé. Les automatisations vérifient les changements de pull requests selon l’intervalle habituel."
