    "Click, then press a combination that includes ⌘. Delete clears it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按后，按下包含 ⌘ 的组合键。按 Delete 清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
