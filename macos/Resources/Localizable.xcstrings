            "value": "CI 通过后批准可信作者的 PR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CI 通過後核准信任作者的 PR。"
          }
        },
        "hi": {
          "stringUnit": {
