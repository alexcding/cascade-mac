        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी शॉर्टकट पर क्लिक करें, फिर नया कुंजी संयोजन दबाएँ। Delete से उसे हटाएँ।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un atajo y pulsa la nueva combinación. Delete lo elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un raccourci, puis appuyez sur la nouvelle combinaison. Delete l’efface."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শর্টকাটে ক্লিক করে নতুন কী সমন্বয় চাপুন। Delete চাপলে এটি মুছে যাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em um atalho e pressione a nova combinação. Delete o remove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на сочетание клавиш, затем введите новое. Delete удаляет сочетание."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットをクリックして、新しいキーの組み合わせを押します。Deleteで消去できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 클릭한 다음 새 키 조합을 누르세요. Delete를 누르면 지워집니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
