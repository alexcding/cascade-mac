    "This page already has an active session operation. Open its session to continue.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面已有正在进行的会话操作。请打开其会话以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
