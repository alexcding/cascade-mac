    "Sessions using this worktree changed. Close this dialog and review removal again." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ওয়ার্কট্রির সেশন বদলেছে। ডায়ালগ বন্ধ করে অপসারণ আবার যাচাই করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones de este árbol cambiaron. Cierra el diálogo y revisa la eliminación de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions de cet arbre ont changé. Fermez cette boîte de dialogue et réexaminez la suppression."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस वर्कट्री के सत्र बदल गए। संवाद बंद करके हटाने की फिर समीक्षा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sessioni di questo albero sono cambiate. Chiudi la finestra e verifica di nuovo la rimozione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このワークツリーを使用するセッションが変わりました。ダイアログを閉じて削除内容を再確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업 트리를 사용하는 세션이 변경되었습니다. 대화 상자를 닫고 제거 내용을 다시 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões desta árvore mudaram. Feche o diálogo e revise a remoção novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеансы этого рабочего дерева изменились. Закройте диалог и проверьте удаление заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionerna i arbetsträdet har ändrats. Stäng dialogrutan och granska borttagningen igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此工作树的会话已更改。请关闭此对话框并重新检查移除操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此工作樹的工作階段已變更。請關閉此對話框並重新檢查移除操作。"
          }
        }
      }
    },
    "Set a Fix Version and close linked tickets when a PR merges." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PR মার্জ হলে ফিক্স সংস্করণ সেট করে যুক্ত টিকিট বন্ধ করে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define la versión de corrección y cierra tickets vinculados al fusionar un PR."
          }
        },
        "fr" : {
          "stringUnit" : {
