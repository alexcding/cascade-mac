          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт проект Jira для задач и доски спринта. Используйте условие фильтра, например %@, для сужения результатов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チケットとスプリントボードの Jira プロジェクトを設定します。%@ などのフィルター条件で結果を絞り込めます。"
          }
