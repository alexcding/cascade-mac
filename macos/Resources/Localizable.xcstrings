    "Could not find executable ‘%@’. Check the custom command and PATH.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可执行文件“%@”。请检查自定义命令和 PATH。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到可執行檔「%@」。請檢查自訂命令和 PATH。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निष्पादन योग्य ‘%@’ नहीं मिला। कस्टम कमांड और PATH जाँचें।"
