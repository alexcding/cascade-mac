        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "티켓 및 스프린트 보드의 Jira 프로젝트를 설정합니다. %@ 같은 필터 조건으로 결과를 좁힐 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anger Jira-projekt för Ärenden och Sprinttavla. Begränsa resultaten med ett filtervillkor, till exempel %@."
          }
        },
        "it": {
          "stringUnit": {
