    "Low values thicken subtly; high values read as bold." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কম মান লেখা সামান্য মোটা করে; বেশি মান বোল্ডের মতো দেখায়।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores bajos engrosan ligeramente; los altos se parecen a la negrita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les valeurs basses épaississent légèrement ; les valeurs hautes ressemblent au gras."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कम मान अक्षर थोड़े मोटे करते हैं; अधिक मान बोल्ड जैसे दिखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori bassi aumentano poco lo spessore; valori alti somigliano al grassetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さい値では少し太く、大きい値では太字に近くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮은 값은 약간 굵게, 높은 값은 볼드체처럼 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores baixos engrossam levemente; valores altos parecem negrito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низкие значения слегка утолщают текст; высокие похожи на полужирный шрифт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låga värden gör texten lite tjockare; höga värden liknar fetstil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "较低值略微加粗，较高值接近粗体。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "較低值略微加粗，較高值接近粗體。"
          }
        }
      }
    },
    "macOS could not find this login item. Reinstall the packaged app." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS এই লগইন আইটেম খুঁজে পায়নি। প্যাকেজ করা অ্যাপ আবার ইনস্টল করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no encontró este ítem de inicio. Reinstala la app distribuida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne trouve pas cet élément d’ouverture. Réinstallez l’app distribuée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS को यह लॉगिन आइटम नहीं मिला। पैकेज किया गया ऐप फिर इंस्टॉल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non trova questo elemento di login. Reinstalla l’app distribuita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS がログイン項目を見つけられませんでした。配布版アプリを再インストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 로그인 항목을 찾지 못했습니다. 배포용 앱을 다시 설치하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não encontrou este item de início. Reinstale o app distribuído."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS не нашла объект входа. Переустановите готовую сборку приложения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hittade inte inloggningsobjektet. Installera om den paketerade appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 找不到此登录项。请重新安装发布版应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 找不到此登入項目。請重新安裝發佈版 App。"
          }
        }
      }
    },
    "macOS could not open the application (exit %lld). Check that it is installed and the target exists." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS অ্যাপ খুলতে পারেনি (প্রস্থান %lld)। ইনস্টল ও লক্ষ্য আছে কি না যাচাই করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no pudo abrir la aplicación (salida %lld). Comprueba que esté instalada y que el destino exista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas pu ouvrir l’application (code %lld). Vérifiez son installation et l’existence de la cible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
