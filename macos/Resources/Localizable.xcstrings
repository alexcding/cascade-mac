    "Optional for iOS projects: run an app in Simulator to interact with it beside your session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 项目的可选功能：在模拟器中运行应用，即可在会话旁与它交互。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 專案的選用功能：在模擬器中執行 App，即可在工作階段旁與它互動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS プロジェクト向けの任意機能です。シミュレータでアプリを実行すると、セッションの横で操作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 프로젝트용 선택 기능입니다. 시뮬레이터에서 앱을 실행하면 세션 옆에서 조작할 수 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para proyectos iOS: ejecuta una app en el simulador para interactuar con ella junto a tu sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif pour les projets iOS : lancez une app dans le simulateur pour interagir avec elle à côté de votre session."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional para projetos iOS: execute um app no simulador para interagir com ele ao lado da sessão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt för iOS-projekt: kör en app i simulatorn för att använda den bredvid din session."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo per i progetti iOS: esegui un’app nel simulatore per usarla accanto alla sessione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно для проектов iOS: запустите приложение в симуляторе, чтобы работать с ним рядом с сессией."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS प्रोजेक्ट के लिए वैकल्पिक: सिम्युलेटर में ऐप चलाकर अपने सत्र के बगल में उसका इस्तेमाल करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS প্রকল্পের জন্য ঐচ্ছিক: সিমুলেটরে অ্যাপ চালিয়ে সেশনের পাশেই সেটি ব্যবহার করুন।"
          }
        }
