    "Voice input in terminal sessions and agents runs under Cascade's permission.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端会话和代理的语音输入使用 Cascade 的麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機工作階段與代理程式的語音輸入使用 Cascade 的麥克風權限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल सत्र और एजेंट में आवाज़ से इनपुट Cascade की अनुमति से चलता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de voz de terminales y agentes usa el permiso de Cascade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie vocale des sessions de terminal et des agents utilise l’autorisation de Cascade."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনাল সেশন ও এজেন্টে ভয়েস ইনপুট Cascade-এর অনুমতি ব্যবহার করে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada de voz em terminais e agentes usa a permissão do Cascade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой ввод в терминалах и агентах использует разрешение Cascade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルセッションとエージェントの音声入力には Cascade の権限を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 세션과 에이전트의 음성 입력은 Cascade의 권한을 사용합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Röstinmatning i terminalsessioner och agenter använder Cascades behörighet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’input vocale in terminali e agenti usa l’autorizzazione di Cascade."
          }
        }
      }
    },
    "Not requested. Cascade asks the first time a session needs the microphone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未请求。会话首次需要麦克风时，Cascade 会请求权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未要求。工作階段首次需要麥克風時，Cascade 會要求權限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध नहीं किया गया। सत्र को पहली बार माइक्रोफ़ोन चाहिए होने पर Cascade पूछता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No solicitado. Cascade lo pide la primera vez que una sesión necesita el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non demandé. Cascade demande l’autorisation la première fois qu’une session a besoin du micro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো অনুরোধ করা হয়নি। কোনো সেশনে প্রথম মাইক্রোফোন দরকার হলে Cascade অনুমতি চায়।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não solicitado. O Cascade pede quando uma sessão precisa do microfone pela primeira vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не запрошено. Cascade запросит доступ, когда сессии впервые понадобится микрофон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未リクエストです。セッションで初めてマイクが必要になったときに Cascade が確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 요청하지 않았습니다. 세션에 마이크가 처음 필요할 때 Cascade가 요청합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte begärt. Cascade frågar när en session behöver mikrofonen för första gången."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non richiesto. Cascade chiede il permesso quando una sessione ha bisogno del microfono per la prima volta."
          }
        }
      }
    },
    "Allowed. Sessions and agents running in Cascade can use the microphone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已允许。在 Cascade 中运行的会话和代理可以使用麦克风。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已允許。在 Cascade 中執行的工作階段與代理程式可使用麥克風。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति है। Cascade में चल रहे सत्र और एजेंट माइक्रोफ़ोन इस्तेमाल कर सकते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido. Las sesiones y agentes de Cascade pueden usar el micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé. Les sessions et agents exécutés dans Cascade peuvent utiliser le micro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুমোদিত। Cascade-এ চলা সেশন ও এজেন্ট মাইক্রোফোন ব্যবহার করতে পারে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido. Sessões e agentes no Cascade podem usar o microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено. Сессии и агенты в Cascade могут использовать микрофон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可済みです。Cascade のセッションとエージェントがマイクを使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용되었습니다. Cascade에서 실행 중인 세션과 에이전트가 마이크를 사용할 수 있습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåtet. Sessioner och agenter i Cascade kan använda mikrofonen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentito. Le sessioni e gli agenti in Cascade possono usare il microfono."
          }
        }
      }
    },
    "Denied. Allow Cascade under Privacy & Security › Microphone.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝。请在“隐私与安全性 › 麦克风”中允许 Cascade。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒絕。請在「隱私權與安全性 › 麥克風」中允許 Cascade。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमति नहीं है। गोपनीयता और सुरक्षा › माइक्रोफ़ोन में Cascade को अनुमति दें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Denegado. Permite Cascade en Privacidad y seguridad › Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusé. Autorisez Cascade dans Confidentialité et sécurité › Microphone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যাখ্যাত। গোপনীয়তা ও নিরাপত্তা › মাইক্রোফোনে Cascade-কে অনুমতি দিন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Negado. Permita o Cascade em Privacidade e Segurança › Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрещено. Разрешите Cascade доступ в разделе «Конфиденциальность и безопасность › Микрофон»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されています。「プライバシーとセキュリティ › マイク」で Cascade を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거부되었습니다. 개인정보 보호 및 보안 › 마이크에서 Cascade를 허용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekat. Tillåt Cascade under Integritet och säkerhet › Mikrofon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Negato. Autorizza Cascade in Privacy e sicurezza › Microfono."
          }
        }
      }
    },
    "Restricted by a system policy; Cascade cannot request it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统策略限制了访问，Cascade 无法请求权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統政策限制了存取，Cascade 無法要求權限。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम नीति से प्रतिबंधित है; Cascade अनुमति नहीं माँग सकता।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restringido por una política del sistema; Cascade no puede solicitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restreint par une règle système ; Cascade ne peut pas demander l’accès."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিস্টেম নীতিতে সীমাবদ্ধ; Cascade অনুমতি চাইতে পারে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restrito por uma política do sistema; o Cascade não pode solicitar acesso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничено системной политикой; Cascade не может запросить доступ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムポリシーで制限されているため、Cascade はアクセスを要求できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 정책으로 제한되어 Cascade가 요청할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Begränsat av en systempolicy; Cascade kan inte begära åtkomst."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitato da una policy di sistema; Cascade non può richiedere l’accesso."
          }
        }
      }
    },
    "Launch at login is unavailable in development builds. Use the packaged release app.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发版本不支持登录时启动。请使用打包的发布版应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發版本不支援登入時啟動。請使用封裝的發佈版 App。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपमेंट बिल्ड में लॉगिन पर शुरू करना उपलब्ध नहीं है। पैकेज किया गया रिलीज़ ऐप इस्तेमाल करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión no está disponible en compilaciones de desarrollo. Usa la app de distribución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ouverture à la connexion n’est pas disponible dans les versions de développement. Utilisez l’app de distribution."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেভেলপমেন্ট বিল্ডে লগইনের সময় চালু করা যায় না। প্যাকেজ করা রিলিজ অ্যাপ ব্যবহার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir ao iniciar sessão não está disponível em builds de desenvolvimento. Use o app de distribuição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автозапуск недоступен в сборках для разработки. Используйте готовую релизную сборку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発ビルドではログイン時に起動できません。配布用リリースアプリを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 빌드에서는 로그인 시 실행을 사용할 수 없습니다. 배포용 릴리스 앱을 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Start vid inloggning är inte tillgängligt i utvecklingsbyggen. Använd den paketerade releaseappen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apertura al login non è disponibile nelle build di sviluppo. Usa l’app di rilascio distribuita."
          }
        }
      }
    },
