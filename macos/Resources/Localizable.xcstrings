        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En session per arbetsträd"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sessione per albero di lavoro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна сессия на рабочее дерево"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वर्कट्री के लिए एक सत्र"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি ওয়ার্কট্রিতে একটি সেশন"
          }
        }
      }
    },
    "Each session has its own Git worktree and terminal. Start from a branch name, pull request, or Jira ticket.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个会话都有独立的 Git 工作树和终端。可以从分支名、拉取请求或 Jira 工单开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作階段都有自己的 Git 工作樹與終端機。可以從分支名稱、提取要求或 Jira 議題開始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各セッションに専用の Git ワークツリーとターミナルがあります。ブランチ名、プルリクエスト、Jira チケットから開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션마다 전용 Git 워크트리와 터미널이 있습니다. 브랜치 이름, 풀 리퀘스트 또는 Jira 티켓에서 시작하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión tiene su propio árbol de trabajo de Git y terminal. Empieza con un nombre de rama, una solicitud de incorporación o una incidencia de Jira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque session possède son arbre de travail Git et son terminal. Commencez avec un nom de branche, une pull request ou un ticket Jira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sessão tem sua própria árvore de trabalho Git e terminal. Comece com um nome de branch, pull request ou ticket do Jira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje session har ett eget Git-arbetsträd och en terminal. Börja med ett grennamn, en pull request eller ett Jira-ärende."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sessione ha il proprio albero di lavoro Git e terminale. Inizia da un nome di branch, una pull request o un ticket Jira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждой сессии есть своё рабочее дерево Git и терминал. Начните с имени ветки, пул-реквеста или задачи Jira."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सत्र का अपना Git वर्कट्री और टर्मिनल होता है। ब्रांच के नाम, पुल रिक्वेस्ट या Jira टिकट से शुरू करें।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি সেশনের নিজস্ব Git ওয়ার্কট্রি ও টার্মিনাল থাকে। ব্রাঞ্চের নাম, পুল রিকোয়েস্ট বা Jira টিকিট দিয়ে শুরু করুন।"
          }
        }
      }
    },
    "See which session needs you": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看哪个会话需要你处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看哪個工作階段需要你處理"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なセッションを確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 세션에 도움이 필요한지 확인하세요"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre qué sesión necesita tu atención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repérez la session qui a besoin de vous"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja qual sessão precisa de você"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vilken session som behöver dig"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri quale sessione ha bisogno di te"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, какой сессии нужно внимание"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देखें किस सत्र को आपकी ज़रूरत है"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দেখুন কোন সেশনে আপনাকে দরকার"
          }
        }
      }
    },
    "Agent hooks update the sidebar and notify you when a session needs attention.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理钩子会更新侧边栏，并在会话需要处理时通知你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式掛鉤會更新側邊欄，並在工作階段需要處理時通知你。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントフックがサイドバーを更新し、セッションへの対応が必要なときに通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 훅은 사이드바를 업데이트하고 세션에 주의가 필요하면 알려 줍니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks del agente actualizan la barra lateral y te avisan cuando una sesión necesita atención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks des agents actualisent la barre latérale et vous avertissent lorsqu’une session demande votre attention."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hooks dos agentes atualizam a barra lateral e avisam quando uma sessão precisa de atenção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-hookar uppdaterar sidofältet och meddelar när en session behöver din uppmärksamhet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook degli agenti aggiornano la barra laterale e ti avvisano quando una sessione richiede attenzione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки агентов обновляют боковую панель и сообщают, когда сессии нужно ваше внимание."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट हुक साइडबार अपडेट करते हैं और किसी सत्र पर ध्यान देने की ज़रूरत होने पर सूचना देते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট হুক সাইডবার আপডেট করে এবং কোনো সেশনে মনোযোগ প্রয়োজন হলে জানায়।"
          }
        }
      }
    },
    "Set up your tools, agent hooks, and optional Simulator preview. You can skip setup and return later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置工具、代理钩子和可选的模拟器预览。你可以跳过设置，稍后再来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定工具、代理程式掛鉤與選用的模擬器預覽。你可以略過設定，稍後再回來。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール、エージェントフック、任意のシミュレータプレビューを設定します。スキップして後で設定することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구, 에이전트 훅, 선택 사항인 시뮬레이터 미리 보기를 설정하세요. 건너뛰고 나중에 설정해도 됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura tus herramientas, los hooks del agente y la vista previa opcional del simulador. Puedes omitir la configuración y volver más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez vos outils, les hooks des agents et l’aperçu facultatif du simulateur. Vous pouvez ignorer la configuration et y revenir plus tard."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure suas ferramentas, hooks dos agentes e a prévia opcional do simulador. Você pode pular a configuração e voltar depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ in verktyg, agent-hookar och valfri simulatorförhandsvisning. Du kan hoppa över inställningarna och komma tillbaka senare."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura strumenti, hook degli agenti e l’anteprima facoltativa del simulatore. Puoi saltare la configurazione e riprenderla più tardi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте инструменты, хуки агентов и необязательный предпросмотр симулятора. Настройку можно пропустить и вернуться позже."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने टूल, एजेंट हुक और वैकल्पिक सिम्युलेटर प्रीव्यू सेट करें। सेटअप छोड़कर बाद में लौट सकते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টুল, এজেন্ট হুক ও ঐচ্ছিক সিমুলেটর প্রিভিউ সেট করুন। সেটআপ এড়িয়ে পরে ফিরে আসতে পারেন।"
          }
        }
      }
    },
    "Install the tools you need, then click Refresh. GitHub and Jira features require their command-line tools. Agents are optional.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装需要的工具，然后点击“刷新”。GitHub 和 Jira 功能需要各自的命令行工具。代理是可选的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝需要的工具，再按「重新整理」。GitHub 和 Jira 功能需要各自的命令列工具。代理程式並非必要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なツールをインストールし、「更新」をクリックしてください。GitHub と Jira の機能には、それぞれのコマンドラインツールが必要です。エージェントは任意です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 도구를 설치한 다음 새로 고침을 클릭하세요. GitHub와 Jira 기능에는 각각의 명령줄 도구가 필요합니다. 에이전트는 선택 사항입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala las herramientas necesarias y pulsa Actualizar. Las funciones de GitHub y Jira necesitan sus herramientas de línea de comandos. Los agentes son opcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez les outils nécessaires, puis cliquez sur Actualiser. Les fonctions GitHub et Jira nécessitent leurs outils en ligne de commande. Les agents sont facultatifs."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale as ferramentas necessárias e clique em Atualizar. Os recursos do GitHub e Jira precisam de suas ferramentas de linha de comando. Agentes são opcionais."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera verktygen du behöver och klicka på Uppdatera. GitHub- och Jira-funktioner kräver respektive kommandoradsverktyg. Agenter är valfria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa gli strumenti necessari e fai clic su Aggiorna. Le funzioni GitHub e Jira richiedono i rispettivi strumenti da riga di comando. Gli agenti sono facoltativi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите нужные инструменты и нажмите «Обновить». Функциям GitHub и Jira нужны соответствующие инструменты командной строки. Агенты необязательны."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरी टूल इंस्टॉल करें, फिर रीफ़्रेश करें पर क्लिक करें। GitHub और Jira सुविधाओं के लिए उनके कमांड-लाइन टूल चाहिए। एजेंट वैकल्पिक हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রয়োজনীয় টুল ইনস্টল করে রিফ্রেশে ক্লিক করুন। GitHub ও Jira সুবিধার জন্য তাদের কমান্ড-লাইন টুল দরকার। এজেন্ট বাধ্যতামূলক নয়।"
          }
        }
      }
    },
    "Hooks report when an agent starts and finishes a turn. Installing or removing hooks preserves your other configuration.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钩子会报告代理何时开始和结束一轮任务。安装或移除钩子会保留其他配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掛鉤會回報代理程式何時開始及結束一輪任務。安裝或移除掛鉤會保留其他設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フックはエージェントのターンの開始と終了を報告します。フックを追加・削除しても、他の設定は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "훅은 에이전트 턴의 시작과 종료를 알립니다. 훅을 설치하거나 제거해도 다른 설정은 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hooks informan del inicio y el fin de cada turno del agente. Instalarlos o quitarlos conserva el resto de tu configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les hooks signalent le début et la fin d’un tour de l’agent. Leur installation ou suppression préserve le reste de votre configuration."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os hooks informam quando um turno do agente começa e termina. Instalar ou remover hooks preserva suas outras configurações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hookar rapporterar när en agent börjar och avslutar en tur. Övriga inställningar bevaras när du installerar eller tar bort hookar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli hook segnalano l’inizio e la fine di un turno dell’agente. Installarli o rimuoverli preserva le altre impostazioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки сообщают о начале и завершении хода агента. Их установка или удаление сохраняет остальные настройки."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हुक बताते हैं कि एजेंट का टर्न कब शुरू और खत्म होता है। हुक इंस्टॉल करने या हटाने से आपकी बाकी सेटिंग्स बनी रहती हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হুক জানায় এজেন্টের টার্ন কখন শুরু ও শেষ হয়। হুক ইনস্টল বা সরালেও আপনার অন্য সেটিংস অক্ষত থাকে।"
          }
        }
      }
    },
