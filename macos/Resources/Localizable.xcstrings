          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти страницу. Проверьте адрес и повторите попытку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページを取得できませんでした。アドレスを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지를 조회할 수 없습니다. 주소를 확인하고 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte hitta sidan. Kontrollera adressen och försök igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trovare la pagina. Controlla l’indirizzo e riprova."
          }
        }
      }
    },
    "Branch name can’t start with “-” or end with “/”, “.” or “.lock”": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分支名称不能以“-”开头或以“/”、“.”或“.lock”结尾"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分支名稱不能以「-」開頭或以「/」、「.」或「.lock」結尾"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रांच का नाम “-” से शुरू या “/”, “.”, “.lock” पर खत्म नहीं हो सकता"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre no puede empezar por «-» ni terminar en «/», «.» o «.lock»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom ne peut commencer par « - » ni finir par « / », « . » ou « .lock »"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাঞ্চের নাম “-” দিয়ে শুরু বা “/”, “.” বা “.lock” দিয়ে শেষ হতে পারে না"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome não pode começar com “-” nem terminar com “/”, “.” ou “.lock”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя ветки не может начинаться с «-» или заканчиваться на «/», «.» или «.lock»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチ名は「-」で開始したり「/」「.」「.lock」で終了したりできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브랜치 이름은 “-”로 시작하거나 “/”, “.”, “.lock”으로 끝날 수 없습니다"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Grennamnet får inte börja med ”-” eller sluta med ”/”, ”.” eller ”.lock”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome non può iniziare con “-” né terminare con “/”, “.” o “.lock”"
          }
        }
      }
    },
    "No branch segment may start with “.”": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分支名称的任何段都不能以“.”开头"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分支名稱的任何區段都不能以「.」開頭"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्रांच का कोई खंड “.” से शुरू नहीं हो सकता"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún segmento de la rama puede empezar por «.»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun segment de branche ne peut commencer par « . »"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাঞ্চের কোনো অংশ “.” দিয়ে শুরু হতে পারে না"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum segmento da branch pode começar com “.”"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один сегмент имени ветки не может начинаться с «.»"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランチ名のどの部分も「.」で開始できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브랜치 이름의 어느 부분도 “.”로 시작할 수 없습니다"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen del av grennamnet får börja med ”.”"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun segmento del ramo può iniziare con “.”"
          }
        }
      }
    },
