    "Reads the saved snapshots. Refreshing this inspector does not run GitHub or Jira commands.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取已保存的快照。刷新此检查器不会运行 GitHub 或 Jira 命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取已儲存的快照。重新整理此檢查器不會執行 GitHub 或 Jira 指令。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए स्नैपशॉट पढ़ता है। इस इंस्पेक्टर को रीफ़्रेश करने से GitHub या Jira कमांड नहीं चलतीं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las instantáneas guardadas. Actualizar este inspector no ejecuta comandos de GitHub ni de Jira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les instantanés enregistrés. Actualiser cet inspecteur n’exécute aucune commande GitHub ou Jira."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত স্ন্যাপশট পড়ে। এই পরিদর্শক রিফ্রেশ করলে GitHub বা Jira কমান্ড চলে না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os snapshots salvos. Atualizar este inspetor não executa comandos do GitHub ou Jira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает сохранённые снимки. Обновление этого инспектора не запускает команды GitHub или Jira."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのスナップショットを読み込みます。このインスペクタを更新しても、GitHubやJiraのコマンドは実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 스냅샷을 읽습니다. 이 검사기를 새로 고쳐도 GitHub 또는 Jira 명령은 실행되지 않습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser sparade ögonblicksbilder. Uppdatering av inspektören kör inga GitHub- eller Jira-kommandon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge gli snapshot salvati. Aggiornare questo pannello non esegue comandi GitHub o Jira."
          }
        }
      }
    },
