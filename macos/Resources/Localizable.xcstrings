    "Denied. Allow Cascade under Privacy & Security › Microphone." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রত্যাখ্যাত। গোপনীয়তা ও নিরাপত্তা › মাইক্রোফোনে Cascade-কে অনুমতি দিন।"
          }
