    "Approve the PR as you. Never approves your own PR.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的身份批准 PR。不会批准你自己的 PR。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以你的身分核准 PR。不會核准你自己的 PR。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी ओर से PR मंज़ूर करें। आपके अपने PR मंज़ूर नहीं होते।"
