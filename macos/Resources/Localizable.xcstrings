          "stringUnit": {
            "state": "translated",
            "value": "প্রতি টিকিট বরাদ্দ করুন। @me মানে আপনি; খালি রাখলে বরাদ্দ সরবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
