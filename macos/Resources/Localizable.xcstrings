          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération de session est déjà active pour cette page. Ouvrez sa session pour continuer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পৃষ্ঠায় ইতিমধ্যেই একটি সেশন কাজ চলছে। চালিয়ে যেতে এর সেশন খুলুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página já tem uma operação de sessão ativa. Abra a sessão dela para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой страницы уже выполняется операция с сеансом. Откройте её сеанс для продолжения."
