    "Remove cookies, caches, and site storage from Cascade’s browser. You will be signed out of websites." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cascade-এর ব্রাউজার থেকে কুকি, ক্যাশ ও সাইটের স্টোরেজ সরান। ওয়েবসাইটগুলো থেকে আপনি সাইন আউট হয়ে যাবেন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina cookies, cachés y almacenamiento de sitios del navegador de Cascade. Se cerrarán tus sesiones en los sitios web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les cookies, caches et données des sites du navigateur de Cascade. Vous serez déconnecté des sites web."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cascade के ब्राउज़र से कुकी, कैश और साइट का स्टोरेज हटाएँ। वेबसाइटों से आपका साइन आउट हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove cookie, cache e dati dei siti dal browser di Cascade. Verrai disconnesso dai siti web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cascade のブラウザから Cookie、キャッシュ、サイトの保存データを削除します。Web サイトからサインアウトされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cascade 브라우저의 쿠키, 캐시, 사이트 저장 데이터를 제거합니다. 웹사이트에서 로그아웃됩니다."
