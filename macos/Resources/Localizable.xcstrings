    "Terminal socket path must be absolute and shorter than 104 bytes." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টার্মিনাল সকেট পাথ পূর্ণ এবং 104 বাইটের কম হতে হবে।"
          }
        },
        "es" : {
          "stringUnit" : {
