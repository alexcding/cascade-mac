    "Pause new automatic runs. Automation modes are preserved." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন স্বয়ংক্রিয় চালনা বিরত রাখুন। অটোমেশন মোড বজায় থাকে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa nuevas ejecuciones automáticas. Se conservan los modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause les nouvelles exécutions automatiques. Les modes sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए स्वचालित रन रोकें। ऑटोमेशन मोड सुरक्षित रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospende le nuove esecuzioni automatiche. Le modalità sono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい自動実行を一時停止します。各自動化のモードは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 자동 실행을 일시 정지합니다. 자동화 모드는 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa novas execuções automáticas. Os modos são preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливает новые автоматические запуски. Режимы сохраняются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar nya automatiska körningar. Automatiseringslägen bevaras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停新的自动运行。保留各自动化的模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
