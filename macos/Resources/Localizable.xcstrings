    "Message delivery was interrupted. Earlier input may have been sent. Check the terminal before restarting." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বার্তা পাঠানো বাধাগ্রস্ত হয়েছে। আগের ইনপুট হয়তো পাঠানো হয়েছে। আবার চালু করার আগে টার্মিনাল দেখে নিন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se interrumpió el envío del mensaje. Puede que ya se enviara parte de la entrada. Revisa el terminal antes de reiniciar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi du message a été interrompu. Une partie de la saisie a peut-être déjà été envoyée. Vérifiez le terminal avant de redémarrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेश भेजना बाधित हुआ। पहले का इनपुट शायद भेजा जा चुका है। फिर से शुरू करने से पहले टर्मिनल जाँचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invio del messaggio è stato interrotto. Parte dell’input potrebbe essere già stata inviata. Controlla il terminale prima di riavviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージの送信が中断されました。一部の入力はすでに送信された可能性があります。再起動する前にターミナルを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지 전송이 중단되었습니다. 앞선 입력이 이미 전송되었을 수 있습니다. 다시 시작하기 전에 터미널을 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio da mensagem foi interrompido. Parte da entrada pode já ter sido enviada. Verifique o terminal antes de reiniciar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправка сообщения прервана. Часть ввода могла уже отправиться. Проверьте терминал перед перезапуском."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelandet kunde inte skickas klart. En del av inmatningen kan redan ha skickats. Kontrollera terminalen innan du startar om."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息发送被中断。之前的输入可能已发送。重新启动前请检查终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊息傳送已中斷。先前的輸入可能已送出。重新啟動前請檢查終端機。"
          }
        }
      }
    },
    "Messages must contain text without terminal control characters and fit within 64 KiB." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বার্তায় টার্মিনাল কন্ট্রোল অক্ষর ছাড়া লেখা থাকতে হবে এবং তা ৬৪ KiB-এর মধ্যে হতে হবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes deben contener texto sin caracteres de control de terminal y ocupar como máximo 64 KiB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages doivent contenir du texte sans caractères de contrôle de terminal et ne pas dépasser 64 Kio."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संदेशों में टर्मिनल कंट्रोल वर्णों के बिना टेक्स्ट होना चाहिए और वे 64 KiB के भीतर होने चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi devono contenere testo senza caratteri di controllo del terminale e non superare 64 KiB."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージには端末制御文字を含まないテキストを入力し、64 KiB 以内に収めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지는 터미널 제어 문자가 없는 텍스트여야 하며 64KiB 이내여야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens devem conter texto sem caracteres de controle de terminal e ter no máximo 64 KiB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения должны содержать текст без управляющих символов терминала и занимать не более 64 КиБ."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelanden måste innehålla text utan terminalstyrtecken och rymmas inom 64 KiB."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息必须是不含终端控制字符的文本，且不超过 64 KiB。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊息必須是不含終端機控制字元的文字，且不超過 64 KiB。"
          }
        }
