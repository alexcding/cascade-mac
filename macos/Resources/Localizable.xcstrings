        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন স্বয়ংক্রিয় চালনা বিরত রাখুন। অটোমেশন মোড বজায় থাকে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa novas execuções automáticas. Os modos são preservados."
          }
        },
        "ru": {
