    "Install %@ first. You can add its hooks later in Settings → Integrations.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先安装 %@。之后可在“设置 → 集成”中添加其钩子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先安裝 %@。之後可在「設定 → 整合」中加入其掛鉤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず %@ をインストールしてください。フックは後で「設定 → 連携」から追加できます。"
          }
