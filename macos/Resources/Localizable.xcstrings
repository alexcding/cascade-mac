    "The connection changed while saving. Your draft is kept; review it after reconnecting.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时连接发生变化。草稿已保留，请重新连接后检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存時連線發生變更。草稿已保留，請重新連線後檢查。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजते समय कनेक्शन बदल गया। आपका मसौदा सुरक्षित है; दोबारा जुड़ने के बाद जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión cambió al guardar. Se conserva tu borrador; revísalo al reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a changé pendant l’enregistrement. Votre brouillon est conservé ; vérifiez-le après reconnexion."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষণের সময় সংযোগ বদলেছে। খসড়া রাখা হয়েছে; পুনঃসংযোগের পর যাচাই করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão mudou ao salvar. Seu rascunho foi mantido; revise-o após reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение изменилось во время сохранения. Черновик сохранён; проверьте его после переподключения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中に接続が変更されました。下書きは保持されています。再接続後に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 중 연결이 변경되었습니다. 초안은 유지되며 다시 연결한 후 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslutningen ändrades under sparandet. Utkastet finns kvar; granska det efter återanslutning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è cambiata durante il salvataggio. La bozza è conservata; verificala dopo la riconnessione."
          }
        }
      }
    },
    "This workflow has no commands.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
