    "Install %@ first. You can add its hooks later in Settings → Integrations." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগে %@ ইনস্টল করুন। পরে সেটিংস → ইন্টিগ্রেশন থেকে এর হুক যোগ করতে পারেন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala %@ primero. Puedes añadir sus hooks más tarde en Ajustes → Integraciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez d’abord %@. Vous pourrez ajouter ses hooks dans Réglages → Intégrations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले %@ इंस्टॉल करें। इसके हुक बाद में सेटिंग्स → एकीकरण में जोड़ सकते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installa prima %@. Potrai aggiungere gli hook in Impostazioni → Integrazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず %@ をインストールしてください。フックは後で「設定 → 連携」から追加できます。"
