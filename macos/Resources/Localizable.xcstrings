    "Your pull requests, tickets, and coding agents in one workspace.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一个工作区管理拉取请求、工单和编程代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一個工作區管理提取要求、議題與程式開發代理程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プルリクエスト、チケット、コーディングエージェントを1つのワークスペースに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀 리퀘스트, 티켓, 코딩 에이전트를 하나의 작업 공간에서 관리하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus solicitudes de incorporación, incidencias y agentes de programación en un solo espacio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos pull requests, tickets et agents de développement dans un seul espace de travail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus pull requests, tickets e agentes de programação em um só espaço de trabalho."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina pull requests, ärenden och kodningsagenter i en arbetsyta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull request, ticket e agenti di programmazione in un unico spazio di lavoro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пул-реквесты, задачи и агенты для разработки в одном рабочем пространстве."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पुल रिक्वेस्ट, टिकट और कोडिंग एजेंट एक ही वर्कस्पेस में।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পুল রিকোয়েস্ট, টিকিট ও কোডিং এজেন্ট একই ওয়ার্কস্পেসে।"
          }
        }
      }
    },
