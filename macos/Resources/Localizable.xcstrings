    "Types it into the terminal now. If the agent is asking something there, this answers it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনই টার্মিনালে টাইপ করবে। এজেন্ট সেখানে কিছু জিজ্ঞেস করলে এটি তার উত্তর হবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo escribe ahora en la terminal. Si el agente está preguntando algo, esto lo responde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisit le texte dans le terminal maintenant. Si l’agent y pose une question, ce texte y répond."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे अभी टर्मिनल में टाइप करता है। यदि एजेंट सवाल पूछ रहा है, तो यह उसका जवाब होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive subito nel terminale. Se l’agente sta facendo una domanda, questo sarà la risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐターミナルに入力します。エージェントが質問中の場合はその回答になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 터미널에 입력합니다. 에이전트가 질문 중이면 이 내용이 답변이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita no terminal agora. Se o agente estiver perguntando algo, isso será a resposta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введёт текст в терминал сейчас. Если агент задаёт вопрос, текст станет ответом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver texten i terminalen nu. Om agenten ställer en fråga blir detta svaret."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即输入到终端。如果代理正在提问，这将作为回答。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立即輸入至終端機。如果代理程式正在提問，這將作為回答。"
          }
        }
      }
    },
    "uBlock Origin Lite could not be switched off. Quit and reopen Cascade." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uBlock Origin Lite বন্ধ করা যায়নি। Cascade বন্ধ করে আবার খুলুন।"
