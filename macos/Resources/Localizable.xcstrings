    "Every page visited in any panel is forgotten. Open tabs stay open.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有面板中访问过的页面记录。已打开的标签页保持打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除所有面板中造訪過的頁面記錄。已開啟的分頁保持開啟。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी पैनलों में देखे गए पेजों का इतिहास मिट जाएगा। खुले टैब खुले रहेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se olvidan todas las páginas visitadas en cualquier panel. Las pestañas abiertas permanecen abiertas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pages visitées dans tous les panneaux sont oubliées. Les onglets ouverts le restent."
