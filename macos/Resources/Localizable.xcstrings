    "%@ must include ⌘ to avoid interfering with terminal commands.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须包含 ⌘，以免影响终端命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必須包含 ⌘，以免影響終端機指令。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल कमांड में बाधा से बचने के लिए %@ में ⌘ होना चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe incluir ⌘ para no interferir con los comandos del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit inclure ⌘ pour ne pas interférer avec les commandes du terminal."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনালের কমান্ডে ব্যাঘাত এড়াতে %@-এ ⌘ থাকতে হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve incluir ⌘ para não interferir nos comandos do terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ должно включать ⌘, чтобы не мешать командам терминала."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのコマンドと干渉しないように、%@には⌘を含めてください。"
