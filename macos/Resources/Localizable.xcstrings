        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY 도우미가 네이티브 색상 소유권을 유지하지 않았습니다. 생성된 셸은 유지됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY-hjälpprogrammet bevarade inte inbyggd färgkontroll. Det skapade skalet har behållits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper PTY non ha conservato il controllo nativo dei colori. La shell creata è conservata."
          }
        }
      }
    },
    "The PTY helper did not preserve the requested terminal geometry owner. The created shell has been preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY 辅助程序未保留请求的终端几何信息控制方。已创建的 shell 已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
