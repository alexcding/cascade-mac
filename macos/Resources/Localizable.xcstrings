    "It needs Node.js 20 or later, from Homebrew, the Node.js installer or a version manager. Cascade checks again when you come back to it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要通过 Homebrew、Node.js 安装程序或版本管理器安装 Node.js 20 或更高版本。返回 Cascade 时会再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要透過 Homebrew、Node.js 安裝程式或版本管理器安裝 Node.js 20 或更新版本。返回 Cascade 時會再次檢查。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew, Node.js इंस्टॉलर या संस्करण प्रबंधक से Node.js 20 या बाद का संस्करण चाहिए। वापस आने पर Cascade फिर जाँचेगा।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere Node.js 20 o posterior, instalado con Homebrew, el instalador de Node.js o un gestor de versiones. Cascade lo comprueba al volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite Node.js 20 ou ultérieur, via Homebrew, l’installateur Node.js ou un gestionnaire de versions. Cascade revérifie à votre retour."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew, Node.js ইনস্টলার বা সংস্করণ ম্যানেজার থেকে Node.js 20 বা পরের সংস্করণ দরকার। ফিরে এলে Cascade আবার যাচাই করবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Node.js 20 ou posterior, via Homebrew, instalador do Node.js ou gerenciador de versões. O Cascade verifica novamente quando você volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется Node.js 20 или новее из Homebrew, установщика Node.js или менеджера версий. Cascade проверит снова при вашем возвращении."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew、Node.js インストーラ、またはバージョンマネージャーで Node.js 20 以降をインストールしてください。Cascade に戻ると再確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew, Node.js 설치 프로그램 또는 버전 관리자로 설치한 Node.js 20 이상이 필요합니다. 돌아오면 Cascade가 다시 확인합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver Node.js 20 eller senare från Homebrew, Node.js-installationsprogrammet eller en versionshanterare. Cascade kontrollerar igen när du återvänder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede Node.js 20 o successivo, da Homebrew, dall’installer Node.js o da un gestore di versioni. Cascade ricontrolla al tuo ritorno."
          }
        }
      }
    },
