    "This deletes all logs, including entries hidden by search or Errors only.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除所有日志，包括因搜索或“仅显示错误”而隐藏的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除所有記錄，包括因搜尋或「僅顯示錯誤」而隱藏的記錄。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे सभी लॉग मिट जाएँगे, जिनमें खोज या “केवल त्रुटियाँ” से छिपी प्रविष्टियाँ भी शामिल हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todos los registros, incluidas las entradas ocultas por la búsqueda o por Solo errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les journaux seront supprimés, y compris les entrées masquées par la recherche ou par Erreurs uniquement."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে সব লগ মুছে যাবে, অনুসন্ধান বা “শুধু ত্রুটি” বিকল্পে লুকানো এন্ট্রিগুলোও।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui todos os logs, incluindo entradas ocultas pela busca ou por Somente erros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будут удалены все записи, включая скрытые поиском или фильтром «Только ошибки»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索や「エラーのみ」で非表示になっている項目を含め、すべてのログを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 또는 '오류만'으로 숨겨진 항목을 포함하여 모든 로그를 삭제합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort alla loggar, även poster som döljs av sökningen eller Endast fel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verranno eliminati tutti i log, incluse le voci nascoste dalla ricerca o da Solo errori."
          }
        }
      }
    },
