    "Codex may ask you to review the change before it uses them." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex ব্যবহারের আগে আপনাকে পরিবর্তনটি পর্যালোচনা করতে বলতে পারে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex puede pedirte que revises el cambio antes de usarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex peut vous demander de vérifier la modification avant de les utiliser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex उपयोग से पहले आपसे बदलाव की समीक्षा करने को कह सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex potrebbe chiederti di rivedere la modifica prima di usarli."
