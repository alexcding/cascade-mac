    "Each project gets its own folder inside it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি প্রকল্প এর ভেতরে নিজস্ব ফোল্ডার পাবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada proyecto tendrá su propia carpeta dentro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque projet y dispose de son propre dossier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर प्रोजेक्ट का अपना फ़ोल्डर इसके अंदर बनेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni progetto avrà una cartella al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この中にプロジェクトごとのフォルダを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트마다 이 안에 별도의 폴더가 생깁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada projeto recebe sua própria pasta dentro dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутри каждый проект получит отдельную папку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje projekt får en egen mapp inuti den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个项目会在其中拥有独立的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個專案會在其中擁有自己的資料夾。"
          }
        }
      }
    },
    "Each session has its own Git worktree and terminal. Start from a branch name, pull request, or Jira ticket." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি সেশনের নিজস্ব Git ওয়ার্কট্রি ও টার্মিনাল থাকে। ব্রাঞ্চের নাম, পুল রিকোয়েস্ট বা Jira টিকিট দিয়ে শুরু করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada sesión tiene su propio árbol de trabajo de Git y terminal. Empieza con un nombre de rama, una solicitud de incorporación o una incidencia de Jira."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque session possède son arbre de travail Git et son terminal. Commencez avec un nom de branche, une pull request ou un ticket Jira."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर सत्र का अपना Git वर्कट्री और टर्मिनल होता है। ब्रांच के नाम, पुल रिक्वेस्ट या Jira टिकट से शुरू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni sessione ha il proprio albero di lavoro Git e terminale. Inizia da un nome di branch, una pull request o un ticket Jira."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各セッションに専用の Git ワークツリーとターミナルがあります。ブランチ名、プルリクエスト、Jira チケットから開始できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션마다 전용 Git 워크트리와 터미널이 있습니다. 브랜치 이름, 풀 리퀘스트 또는 Jira 티켓에서 시작하세요."
          }
        },
