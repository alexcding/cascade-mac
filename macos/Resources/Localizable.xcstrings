    "The checkout at %@ does not match branch %@. It has been kept; resolve the branch or folder conflict before running this workflow." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এর চেকআউট ব্রাঞ্চ %@-এর সঙ্গে মেলে না। এটি রাখা হয়েছে; ওয়ার্কফ্লো চালানোর আগে ব্রাঞ্চ বা ফোল্ডারের দ্বন্দ্ব মেটান।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El checkout en %@ no coincide con la rama %@. Se conserva; resuelve el conflicto de rama o carpeta antes de ejecutar el flujo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le checkout à %@ ne correspond pas à la branche %@. Il est conservé ; résolvez le conflit avant d’exécuter ce flux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ का चेकआउट ब्रांच %@ से मेल नहीं खाता। इसे रखा गया है; कार्यप्रवाह चलाने से पहले ब्रांच या फ़ोल्डर का विरोध सुलझाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il checkout in %@ non corrisponde al ramo %@. È stato conservato; risolvi il conflitto di ramo o cartella prima di eseguire il flusso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のチェックアウトはブランチ %@ と一致しません。削除せず保持しました。ワークフロー実行前に競合を解決してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 체크아웃이 브랜치 %@와 일치하지 않습니다. 그대로 유지했으니 워크플로 실행 전에 브랜치 또는 폴더 충돌을 해결하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O checkout em %@ não corresponde à branch %@. Foi mantido; resolva o conflito de branch ou pasta antes de executar o fluxo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рабочая копия в %@ не соответствует ветке %@. Она сохранена; устраните конфликт ветки или папки перед запуском процесса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utcheckningen i %@ matchar inte grenen %@. Den har behållits; lös gren- eller mappkonflikten innan arbetsflödet körs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 处的检出与分支 %@ 不匹配。该检出已保留；请解决分支或文件夹冲突后再运行此工作流。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 處的簽出與分支 %@ 不相符。該簽出已保留；請解決分支或資料夾衝突後再執行此工作流程。"
          }
        }
      }
    },
