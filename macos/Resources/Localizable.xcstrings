    "Your changes will be lost if you discard them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丢弃后将丢失所做更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "捨棄後將遺失所做變更。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "त्यागने पर आपके बदलाव खो जाएँगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si descartas los cambios, se perderán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous les abandonnez, vos modifications seront perdues."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বাতিল করলে পরিবর্তন হারিয়ে যাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações serão perdidas se você descartá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если отменить изменения, они будут потеряны."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄すると失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 버리면 복구할 수 없습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina ändringar går förlorade om du kastar dem."
