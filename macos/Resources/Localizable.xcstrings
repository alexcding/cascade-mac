    "Branch name can’t contain spaces, “..” or ~ ^ : ? * [ \\" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্রাঞ্চের নামে ফাঁকা স্থান, “..” বা এগুলো থাকতে পারে না: ~ ^ : ? * [ \\"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre no puede contener espacios, «..» ni ~ ^ : ? * [ \\"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom ne peut contenir d’espaces, « .. » ni ~ ^ : ? * [ \\"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रांच के नाम में रिक्त स्थान, “..” या ये नहीं हो सकते: ~ ^ : ? * [ \\"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome non può contenere spazi, “..” o ~ ^ : ? * [ \\"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名には空白、「..」、次の記号を含められません： ~ ^ : ? * [ \\"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브랜치 이름에 공백, “..” 또는 다음 문자를 포함할 수 없습니다: ~ ^ : ? * [ \\"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome não pode conter espaços, “..” ou ~ ^ : ? * [ \\"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя ветки не может содержать пробелы, «..» или ~ ^ : ? * [ \\"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grennamnet får inte innehålla blanksteg, ”..” eller ~ ^ : ? * [ \\"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称不能包含空格、“..”或 ~ ^ : ? * [ \\"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱不能包含空格、「..」或 ~ ^ : ? * [ \\"
          }
        }
      }
    },
    "Branch name can’t start with “-” or end with “/”, “.” or “.lock”" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্রাঞ্চের নাম “-” দিয়ে শুরু বা “/”, “.” বা “.lock” দিয়ে শেষ হতে পারে না"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre no puede empezar por «-» ni terminar en «/», «.» o «.lock»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom ne peut commencer par « - » ni finir par « / », « . » ou « .lock »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रांच का नाम “-” से शुरू या “/”, “.”, “.lock” पर खत्म नहीं हो सकता"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome non può iniziare con “-” né terminare con “/”, “.” o “.lock”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名は「-」で開始したり「/」「.」「.lock」で終了したりできません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브랜치 이름은 “-”로 시작하거나 “/”, “.”, “.lock”으로 끝날 수 없습니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome não pode começar com “-” nem terminar com “/”, “.” ou “.lock”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя ветки не может начинаться с «-» или заканчиваться на «/», «.» или «.lock»"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grennamnet får inte börja med ”-” eller sluta med ”/”, ”.” eller ”.lock”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称不能以“-”开头或以“/”、“.”或“.lock”结尾"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱不能以「-」開頭或以「/」、「.」或「.lock」結尾"
          }
        }
      }
    },
