          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र के वर्कट्री खोलने के लिए उपयोग होने वाला एडिटर। प्रोजेक्ट के सेटिंग्स टैब में लॉन्च लक्ष्य सेट करें।"
