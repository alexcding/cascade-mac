          }
        }
      }
    },
    "This PTY helper cannot report incomplete history. Rebuild the helper before reattaching.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PTY 辅助程序无法报告不完整的历史记录。请重新构建辅助程序后再附加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 PTY 輔助程式無法回報不完整的歷史記錄。請重新建置輔助程式後再附加。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह PTY हेल्पर अधूरे इतिहास की सूचना नहीं दे सकता। दोबारा अटैच करने से पहले हेल्पर फिर बिल्ड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este auxiliar PTY no puede informar de un historial incompleto. Recompílalo antes de reconectar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet utilitaire PTY ne peut pas signaler un historique incomplet. Recompilez-le avant le rattachement."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই PTY সহায়ক অসম্পূর্ণ ইতিহাস জানাতে পারে না। আবার সংযুক্ত করার আগে সহায়কটি পুনরায় বিল্ড করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este auxiliar PTY não pode informar um histórico incompleto. Recompile-o antes de reconectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот помощник PTY не может сообщать о неполной истории. Пересоберите его перед присоединением."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この PTY ヘルパーは不完全な履歴を報告できません。再接続する前にヘルパーを再ビルドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PTY 도우미는 불완전한 기록을 보고할 수 없습니다. 다시 연결하기 전에 도우미를 다시 빌드하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här PTY-hjälpprogrammet kan inte rapportera ofullständig historik. Bygg om det före återanslutning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo helper PTY non può segnalare una cronologia incompleta. Ricompilalo prima di ricollegarti."
          }
        }
      }
    },
    "This shell has an incompatible appearance owner. The existing shell has been preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 shell 的外观控制方不兼容。现有 shell 已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 shell 的外觀控制方不相容。現有 shell 已保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शेल का रूप नियंत्रक असंगत है। मौजूदा शेल सुरक्षित है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este shell tiene un responsable de apariencia incompatible. Se conservó el shell existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le responsable de l’apparence de ce shell est incompatible. Le shell existant est conservé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই শেলের চেহারার নিয়ন্ত্রক অসামঞ্জস্যপূর্ণ। বিদ্যমান শেল রাখা হয়েছে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este shell tem um responsável pela aparência incompatível. O shell existente foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этой оболочки несовместимый владелец оформления. Существующая оболочка сохранена."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシェルの外観の管理元は非互換です。既存のシェルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 셸의 모양 소유자가 호환되지 않습니다. 기존 셸은 유지됩니다."
          }
        },
        "sv": {
