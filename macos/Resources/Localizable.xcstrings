    "Still open in %@. Xcode is asked to close it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও %@-এ খোলা। Xcode-কে বন্ধ করতে বলা হবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue abierto en %@. Se pedirá a Xcode que lo cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours ouvert dans %@. Il sera demandé à Xcode de le fermer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी %@ में खुला है। Xcode से इसे बंद करने को कहा जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora aperto in %@. Verrà chiesto a Xcode di chiuderlo."
