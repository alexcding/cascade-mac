    "%@ returned to the shell after resuming. If you did not quit it, check the terminal for details.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 恢复后返回了 shell。如果你没有主动退出，请在终端中查看详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 繼續後返回了 shell。如果你沒有主動結束，請在終端機中查看詳細資訊。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ फिर शुरू होने के बाद शेल में लौट आया। यदि आपने इसे बंद नहीं किया, तो विवरण के लिए टर्मिनल देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ volvió al shell tras reanudarse. Si no lo cerraste, consulta el terminal para más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est revenu au shell après la reprise. Si vous ne l’avez pas quitté, consultez le terminal pour plus de détails."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আবার শুরু হওয়ার পর %@ শেলে ফিরে এসেছে। আপনি বন্ধ না করে থাকলে বিস্তারিত জানতে টার্মিনল দেখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ voltou ao shell após retomar. Se você não o encerrou, veja os detalhes no terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вернулся в оболочку после возобновления. Если вы его не закрывали, проверьте подробности в терминале."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は再開後にシェルに戻りました。終了していない場合は、ターミナルで詳細を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 재개 후 셸로 돌아왔습니다. 직접 종료하지 않았다면 터미널에서 세부 정보를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ återgick till skalet efter återupptagning. Om du inte avslutade det, se terminalen för detaljer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è tornato alla shell dopo la ripresa. Se non lo hai chiuso, controlla i dettagli nel terminale."
          }
        }
      }
    },
    "%@ returned to the shell after starting. If you did not quit it, check the terminal for details.": {
