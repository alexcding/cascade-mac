    "History changed while loading older commits. Refresh history to continue." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরোনো কমিট লোড করার সময় ইতিহাস বদলেছে। চালিয়ে যেতে ইতিহাস রিফ্রেশ করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial cambió al cargar commits antiguos. Actualízalo para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique a changé pendant le chargement d’anciens commits. Actualisez-le pour continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुराने कमिट लोड करते समय इतिहास बदल गया। जारी रखने के लिए इतिहास रीफ़्रेश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia è cambiata durante il caricamento dei commit precedenti. Aggiornala per continuare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いコミットの読み込み中に履歴が変わりました。履歴を更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 커밋을 로드하는 동안 기록이 변경되었습니다. 계속하려면 새로 고치세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O histórico mudou ao carregar commits antigos. Atualize-o para continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История изменилась при загрузке старых коммитов. Обновите её для продолжения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiken ändrades när äldre incheckningar lästes in. Uppdatera den för att fortsätta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加载更早提交时历史记录已更改。请刷新历史记录后继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "載入較舊提交時歷程已變更。請重新整理歷程後繼續。"
          }
        }
      }
    },
