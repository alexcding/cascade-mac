          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho do socket deve ser absoluto e menor que 104 bytes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь к сокету терминала должен быть абсолютным и короче 104 байт."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルのソケットパスは絶対パスで104バイト未満にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 소켓 경로는 절대 경로이며 104바이트 미만이어야 합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalens socketsökväg måste vara absolut och kortare än 104 byte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il percorso del socket deve essere assoluto e inferiore a 104 byte."
          }
        }
      }
    },
    "The agent already has an active turn or workflow step.": {
      "localizations": {
        "zh-Hans": {
