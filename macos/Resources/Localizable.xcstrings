          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте {path} для рабочей копии. Кавычки группируют аргументы; подстановки оболочки и конвейеры не поддерживаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd {path} för arbetskopian. Citattecken grupperar argument; skalexpansion och pipelines stöds inte."
