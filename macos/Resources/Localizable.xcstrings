        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続または消去リクエストが変更されました。キャンセルしてカテゴリを再確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 또는 지우기 요청이 변경되었습니다. 취소한 후 범주를 다시 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão ou a solicitação de limpeza mudou. Cancele e confira a categoria novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключение или запрос на очистку изменились. Отмените действие и снова проверьте категорию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anslutningen eller rensningsbegäran har ändrats. Avbryt och kontrollera kategorin igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接或清除请求已更改。请取消并重新确认类别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線或清除要求已變更。請取消並重新確認類別。"
          }
        }
      }
    },
    "The daemon returned an incompatible or invalid terminal snapshot header." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেমন অসামঞ্জস্যপূর্ণ বা অবৈধ টার্মিনাল স্ন্যাপশট হেডার ফিরিয়েছে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El daemon devolvió una cabecera de instantánea incompatible o no válida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le démon a renvoyé un en-tête d’instantané incompatible ou non valide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेमन ने असंगत या अमान्य टर्मिनल स्नैपशॉट हेडर लौटाया।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il demone ha restituito un’intestazione dell’istantanea incompatibile o non valida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デーモンが非互換または無効なターミナルスナップショットヘッダーを返しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데몬이 호환되지 않거나 유효하지 않은 터미널 스냅샷 헤더를 반환했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O daemon retornou um cabeçalho de instantâneo incompatível ou inválido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демон вернул несовместимый или недопустимый заголовок снимка терминала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daemonen returnerade ett inkompatibelt eller ogiltigt huvud för terminalens ögonblicksbild."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "守护进程返回了不兼容或无效的终端快照头。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景程序傳回了不相容或無效的終端機快照標頭。"
          }
        }
      }
    },
    "The daemon returned an incomplete or out-of-order terminal snapshot chunk." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেমন অসম্পূর্ণ বা ভুল ক্রমের টার্মিনাল স্ন্যাপশট খণ্ড ফিরিয়েছে।"
          }
        },
        "es" : {
          "stringUnit" : {
