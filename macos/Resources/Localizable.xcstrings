        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पृष्ठ पर पहले से एक सत्र कार्रवाई चल रही है। जारी रखने के लिए इसका सत्र खोलें।"
          }
        },
        "es": {
