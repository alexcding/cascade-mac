        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать миниатюрный обзор рядом с файлом."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल के पास उसका छोटा अवलोकन दिखाएँ।"
          }
