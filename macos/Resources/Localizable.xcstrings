        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà anche il nome alla cartella dell’albero di lavoro. Oppure incolla un URL GitHub PR / Jira per partire da quella pagina."
          }
        }
      }
    },
    "Opens that pull request — name its branch below": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
