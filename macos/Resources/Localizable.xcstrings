    "Use a new client for each terminal connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个终端连接都需使用新客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個終端機連線都需使用新用戶端。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टर्मिनल कनेक्शन के लिए नया क्लाइंट उपयोग करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un cliente nuevo para cada conexión del terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un nouveau client pour chaque connexion au terminal."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি টার্মিনাল সংযোগের জন্য নতুন ক্লায়েন্ট ব্যবহার করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
