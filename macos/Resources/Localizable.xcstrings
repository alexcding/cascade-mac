          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট ব্যস্ত। আগে তার বর্তমান পালা শেষ করুন বা থামান।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
