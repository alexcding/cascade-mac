    },
    "This removes the project configuration and PR/Jira links. Sessions remain under Sessions, and workspace folders and running terminals are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে প্রকল্পের কনফিগারেশন ও PR/Jira লিংক মুছে যাবে। সেশনগুলো সেশন বিভাগে থাকবে; ওয়ার্কস্পেস ফোল্ডার ও চলমান টার্মিনালও থাকবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminan la configuración del proyecto y los vínculos de PR/Jira. Las sesiones permanecen en Sesiones; se conservan las carpetas de trabajo y los terminales activos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration du projet et les liens PR/Jira seront supprimés. Les sessions restent dans Sessions ; les dossiers de travail et les terminaux actifs sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे प्रोजेक्ट कॉन्फ़िगरेशन और PR/Jira लिंक हटते हैं। सत्र, सत्र अनुभाग में रहेंगे; वर्कस्पेस फ़ोल्डर और चल रहे टर्मिनल भी बने रहेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono rimossi la configurazione del progetto e i collegamenti PR/Jira. Le sessioni restano in Sessioni; le cartelle di lavoro e i terminali attivi vengono conservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト設定と PR/Jira のリンクを削除します。セッションは「セッション」に残り、ワークスペースフォルダと実行中のターミナルも保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로젝트 설정과 PR/Jira 링크를 삭제합니다. 세션은 세션 목록에 남으며 작업 공간 폴더와 실행 중인 터미널도 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove a configuração do projeto e os vínculos de PR/Jira. As sessões permanecem em Sessões; as pastas de trabalho e os terminais em execução são mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены настройки проекта и связи с PR/Jira. Сеансы останутся в разделе «Сеансы», рабочие папки и запущенные терминалы сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektinställningarna och PR/Jira-länkarna tas bort. Sessionerna finns kvar under Sessioner, och arbetsmappar och aktiva terminaler behålls."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会移除项目配置及 PR/Jira 关联。会话仍保留在“会话”中，工作区文件夹和运行中的终端也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會移除專案設定及 PR/Jira 連結。工作階段仍保留在「工作階段」中，工作區檔案夾和執行中的終端機也會保留。"
          }
        }
      }
    },
    "This rewrites the selected block on disk and cannot be undone. Other change blocks remain." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডিস্কের নির্বাচিত ব্লক আবার লেখা হবে, যা ফেরানো যাবে না। অন্য পরিবর্তন থাকবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se reescribe el bloque seleccionado en disco y no se puede deshacer. Los demás bloques se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bloc sélectionné est réécrit sur le disque, sans possibilité d’annulation. Les autres blocs sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिस्क पर चुना ब्लॉक फिर लिखता है और इसे वापस नहीं किया जा सकता। बाकी बदलाव बने रहेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco selezionato viene riscritto su disco senza possibilità di annullare. Gli altri blocchi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスク上の選択ブロックを書き換えます。取り消せません。他の変更ブロックは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크의 선택한 블록을 다시 쓰며 되돌릴 수 없습니다. 다른 변경 블록은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso reescreve o bloco selecionado no disco e não pode ser desfeito. Os outros blocos permanecem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный блок на диске будет перезаписан без возможности отмены. Остальные блоки сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det markerade blocket skrivs om på disken och kan inte ångras. Övriga ändringsblock behålls."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会重写磁盘上的所选块，且无法撤销。其他更改块会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會覆寫磁碟上的所選區塊，且無法復原。其他變更區塊會保留。"
          }
        }
      }
    },
    "This shell has an incompatible appearance owner. The existing shell has been preserved." : {
      "localizations" : {
