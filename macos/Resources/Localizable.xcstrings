    "The agent is busy. Finish or stop its current turn first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理正忙。请先完成或停止当前轮次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式忙碌中。請先完成或停止目前的回合。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट व्यस्त है। पहले उसका वर्तमान टर्न पूरा करें या रोकें।"
          }
        },
        "es": {
          "stringUnit": {
