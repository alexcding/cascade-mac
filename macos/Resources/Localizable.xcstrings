    "No runs yet. They appear here once the automation is on and an event matches its trigger, or after Run for Real." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও চালনা নেই। অটোমেশন চালু ও ঘটনা ট্রিগারের সঙ্গে মিললে, অথবা বাস্তবে চালানোর পর এখানে দেখাবে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay ejecuciones. Aparecen cuando está activada y un evento coincide, o tras Ejecutar de verdad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune exécution. Elles apparaîtront après activation et correspondance d’un événement, ou après Exécuter réellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी कोई रन नहीं। ऑटोमेशन चालू होने और ट्रिगर मेल खाने पर, या वास्तविक रन के बाद यहाँ दिखेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna esecuzione. Appariranno quando l’automazione è attiva e un evento corrisponde al trigger, o dopo Esegui realmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ実行履歴がありません。オンにしてトリガーに一致するイベントが発生するか、実際に実行すると表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 실행 기록이 없습니다. 자동화를 켜고 이벤트가 트리거와 일치하거나 실제로 실행하면 여기에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
