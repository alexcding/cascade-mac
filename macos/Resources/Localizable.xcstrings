    "Repositories forwarding events: %lld of %lld. Cascade checks the rest on its regular schedule." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইভেন্ট পাঠাচ্ছে এমন রিপোজিটরি: %lld, মোট %lld। Cascade বাকিগুলো নিয়মিত সময়সূচি অনুযায়ী পরীক্ষা করে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositorios que reenvían eventos: %lld de %lld. Cascade comprueba el resto con su frecuencia habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépôts transférant des événements : %lld sur %lld. Cascade vérifie les autres selon son intervalle habituel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इवेंट भेज रही रिपॉज़िटरी: %lld, कुल %lld। Cascade बाकी को नियमित अंतराल पर जाँचता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repository che inoltrano eventi: %lld su %lld. Cascade controlla gli altri secondo l’intervallo abituale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを転送中のリポジトリ：%lld／%lld。残りは通常の間隔で確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트를 전달하는 저장소: %lld / %lld. 나머지는 Cascade가 정기적으로 확인합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repositórios encaminhando eventos: %lld de %lld. O Cascade verifica os demais no intervalo habitual."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Репозитории, передающие события: %lld из %lld. Остальные Cascade проверяет по обычному расписанию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kodförråd som vidarebefordrar händelser: %lld av %lld. Cascade kontrollerar resten enligt det vanliga schemat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在转发事件的仓库数：%lld，共 %lld 个。Cascade 会按常规计划检查其余仓库。"
