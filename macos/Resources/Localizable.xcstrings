        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão do terminal foi perdida. Verifique-o antes de reiniciar o fluxo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение с терминалом потеряно. Проверьте терминал перед перезапуском процесса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルの接続が失われました。ワークフローの再開前にターミナルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 연결이 끊겼습니다. 워크플로를 다시 시작하기 전에 터미널을 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalanslutningen förlorades. Kontrollera terminalen innan du startar om arbetsflödet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione al terminale è persa. Controllalo prima di riavviare il flusso."
          }
        }
      }
    },
    "The agent is not running, or the PTY helper needs updating. Open the terminal and check its startup before retrying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理未运行，或 PTY 辅助程序需要更新。请打开终端并检查启动情况后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代理程式未執行，或 PTY 輔助程式需要更新。請開啟終端機並檢查啟動情況後重試。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एजेंट नहीं चल रहा या PTY हेल्पर को अपडेट चाहिए। टर्मिनल खोलकर उसका स्टार्टअप जाँचें, फिर प्रयास करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente no está en ejecución o el auxiliar PTY necesita actualizarse. Abre el terminal y revisa su inicio antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agent ne s’exécute pas ou l’utilitaire PTY doit être mis à jour. Ouvrez le terminal et vérifiez son démarrage avant de réessayer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এজেন্ট চলছে না বা PTY সহায়ক হালনাগাদ দরকার। আবার চেষ্টার আগে টার্মিনাল খুলে তার শুরু পরীক্ষা করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente não está em execução ou o auxiliar PTY precisa ser atualizado. Abra o terminal e confira a inicialização antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент не запущен или помощник PTY требует обновления. Откройте терминал и проверьте запуск перед повтором."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが実行されていないか、PTY ヘルパーの更新が必要です。ターミナルを開き、起動状態を確認してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 실행 중이 아니거나 PTY 도우미 업데이트가 필요합니다. 터미널을 열어 시작 상태를 확인한 후 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten körs inte eller PTY-hjälpprogrammet behöver uppdateras. Öppna terminalen och kontrollera starten innan du försöker igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’agente non è in esecuzione o l’helper PTY richiede un aggiornamento. Apri il terminale e verifica l’avvio prima di riprovare."
          }
        }
      }
    },
    "The foreground program is %@, not the selected %@ agent. Return to the shell before running this workflow.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前台程序是 %@，而非所选的 %@ 代理。请返回 shell 后再运行此工作流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "前景程式是 %@，而非所選的 %@ 代理程式。請返回 shell 後再執行此工作流程。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अग्रभूमि प्रोग्राम %@ है, चुना गया %@ एजेंट नहीं। वर्कफ़्लो चलाने से पहले शेल में लौटें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa en primer plano es %@, no el agente %@ seleccionado. Vuelve al shell antes de ejecutar el flujo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme au premier plan est %@, et non l’agent %@ sélectionné. Revenez au shell avant d’exécuter ce workflow."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সামনের প্রোগ্রাম %@, নির্বাচিত %@ এজেন্ট নয়। ওয়ার্কফ্লো চালানোর আগে শেলে ফিরুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O programa em primeiro plano é %@, não o agente %@ selecionado. Volte ao shell antes de executar o fluxo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программа на переднем плане — %@, а не выбранный агент %@. Вернитесь в оболочку перед запуском процесса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォアグラウンドのプログラムは %@ で、選択した %@ エージェントではありません。このワークフローを実行する前にシェルに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포그라운드 프로그램은 %@이며 선택한 %@ 에이전트가 아닙니다. 이 워크플로를 실행하기 전에 셸로 돌아가세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förgrundsprogrammet är %@, inte den valda agenten %@. Återgå till skalet innan du kör arbetsflödet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma in primo piano è %@, non l’agente %@ selezionato. Torna alla shell prima di eseguire il flusso."
          }
        }
      }
    },
    "The native terminal version or bundled terminfo is missing. Rebuild the app before creating a terminal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少原生终端版本或捆绑的 terminfo。请重新构建应用后再创建终端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少原生終端機版本或隨附的 terminfo。請重新建置 App 後再建立終端機。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटिव टर्मिनल संस्करण या बंडल किया terminfo नहीं मिला। टर्मिनल बनाने से पहले ऐप फिर बिल्ड करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la versión del terminal nativo o el terminfo incluido. Vuelve a compilar la app antes de crear un terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version du terminal natif ou le terminfo intégré est manquant. Recompilez l’app avant de créer un terminal."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নেটিভ টার্মিনাল সংস্করণ বা বান্ডল করা terminfo নেই। টার্মিনাল তৈরির আগে অ্যাপ আবার বিল্ড করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão do terminal nativo ou o terminfo incluído está ausente. Recompile o app antes de criar um terminal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсутствует версия нативного терминала или встроенный terminfo. Пересоберите приложение перед созданием терминала."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブターミナルのバージョンまたは同梱の terminfo がありません。ターミナルを作成する前にアプリを再ビルドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 터미널 버전 또는 번들 terminfo가 없습니다. 터미널을 만들기 전에 앱을 다시 빌드하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionen av den inbyggda terminalen eller medföljande terminfo saknas. Bygg om appen innan du skapar en terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manca la versione del terminale nativo o il terminfo incluso. Ricompila l’app prima di creare un terminale."
          }
        }
      }
    },
    "The original terminal is no longer running. Automatic reconnect did not create a replacement shell.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原终端已不再运行。自动重连未创建替代 shell。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原終端機已不再執行。自動重新連線未建立替代 shell。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल टर्मिनल अब नहीं चल रहा। स्वतः पुनः कनेक्शन ने नया शेल नहीं बनाया।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El terminal original ya no está en ejecución. La reconexión automática no creó un shell sustituto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le terminal d’origine n’est plus actif. La reconnexion automatique n’a pas créé de shell de remplacement."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মূল টার্মিনাল আর চলছে না। স্বয়ংক্রিয় পুনঃসংযোগ বিকল্প শেল তৈরি করেনি।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O terminal original não está mais em execução. A reconexão automática não criou um shell substituto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходный терминал больше не работает. Автоподключение не создало заменяющую оболочку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のターミナルは実行されていません。自動再接続で代わりのシェルは作成されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 터미널이 더 이상 실행 중이 아닙니다. 자동 재연결은 대체 셸을 만들지 않았습니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den ursprungliga terminalen körs inte längre. Automatisk återanslutning skapade inget ersättningsskal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il terminale originale non è più in esecuzione. La riconnessione automatica non ha creato una shell sostitutiva."
          }
        }
      }
    },
    "Workflow commands must contain text without terminal control characters and fit within 64 KiB after expansion.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流命令必须包含文本且不含终端控制字符，展开后不得超过 64 KiB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流程指令必須包含文字且不含終端機控制字元，展開後不得超過 64 KiB。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कफ़्लो कमांड में बिना टर्मिनल नियंत्रण वर्णों का पाठ होना चाहिए और विस्तार के बाद 64 KiB के भीतर होना चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos del flujo deben contener texto sin caracteres de control del terminal y ocupar como máximo 64 KiB tras expandirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes doivent contenir du texte sans caractères de contrôle du terminal et ne pas dépasser 64 KiB après expansion."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ার্কফ্লোর কমান্ডে টার্মিনাল নিয়ন্ত্রণ অক্ষর ছাড়া লেখা থাকতে হবে এবং প্রসারণের পর 64 KiB-এর মধ্যে হতে হবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos devem conter texto sem caracteres de controle do terminal e ter até 64 KiB após a expansão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды процесса должны содержать текст без управляющих символов терминала и занимать не более 64 KiB после подстановок."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローのコマンドにはターミナル制御文字を含まないテキストが必要で、展開後に64 KiB以内でなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로 명령에는 터미널 제어 문자가 없는 텍스트가 있어야 하며 확장 후 64 KiB 이내여야 합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbetsflödeskommandon måste innehålla text utan terminalkontrolltecken och rymmas inom 64 KiB efter expansion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi del flusso devono contenere testo senza caratteri di controllo del terminale e non superare 64 KiB dopo l’espansione."
          }
        }
      }
    },
    "Terminal history was truncated; the screen cannot be restored reliably. The shell is still running. Full-state restoration is required.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端历史记录已截断，无法可靠恢复屏幕。shell 仍在运行，需要完整状态恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機歷史記錄已截斷，無法可靠還原畫面。shell 仍在執行，需要完整狀態還原。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल इतिहास कट गया; स्क्रीन भरोसेमंद रूप से बहाल नहीं हो सकती। शेल अभी चल रहा है। पूर्ण स्थिति बहाली चाहिए।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial del terminal se truncó; no se puede restaurar la pantalla de forma fiable. El shell sigue activo. Se requiere restaurar el estado completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique du terminal a été tronqué ; l’écran ne peut pas être restauré de façon fiable. Le shell reste actif. Une restauration complète de l’état est requise."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "টার্মিনালের ইতিহাস ছাঁটা হয়েছে; পর্দা নির্ভরযোগ্যভাবে ফেরানো যাবে না। শেল এখনও চলছে। পূর্ণ অবস্থা পুনরুদ্ধার প্রয়োজন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico do terminal foi truncado; a tela não pode ser restaurada com segurança. O shell ainda está ativo. É necessária a restauração do estado completo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История терминала обрезана; экран нельзя надёжно восстановить. Оболочка продолжает работать. Требуется восстановление полного состояния."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル履歴が切り詰められたため、画面を確実に復元できません。シェルは実行中です。完全な状態の復元が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널 기록이 잘려 화면을 안정적으로 복원할 수 없습니다. 셸은 계속 실행 중입니다. 전체 상태 복원이 필요합니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminalhistoriken trunkerades; skärmen kan inte återställas tillförlitligt. Skalet körs fortfarande. Fullständig tillståndsåterställning krävs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia è stata troncata; lo schermo non può essere ripristinato in modo affidabile. La shell è ancora attiva. È necessario ripristinare lo stato completo."
          }
        }
      }
    },
    "The PTY helper did not preserve native color ownership. The created shell has been preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY 辅助程序未保留原生颜色控制权。已创建的 shell 已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY 輔助程式未保留原生色彩控制權。已建立的 shell 已保留。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY हेल्पर ने नेटिव रंग का स्वामित्व नहीं रखा। बनाया गया शेल सुरक्षित है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El auxiliar PTY no conservó el control nativo de los colores. Se conservó el shell creado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’utilitaire PTY n’a pas conservé le contrôle natif des couleurs. Le shell créé est conservé."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "PTY সহায়ক নেটিভ রঙের নিয়ন্ত্রণ রাখেনি। তৈরি করা শেল রাখা হয়েছে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O auxiliar PTY não preservou o controle nativo de cores. O shell criado foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник PTY не сохранил нативное управление цветами. Созданная оболочка сохранена."
          }
        },
        "ja": {
          "stringUnit": {
