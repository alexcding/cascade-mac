    "Assign each ticket. @me is you; empty unassigns.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分配每个工单。@me 表示你；留空则取消分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指派每個工單。@me 代表你；留空則取消指派。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर टिकट सौंपें। @me आप हैं; खाली रखने से असाइनमेंट हटता है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna cada ticket. @me eres tú; vacío quita la asignación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribue chaque ticket. @me vous désigne ; vide supprime l’attribution."
