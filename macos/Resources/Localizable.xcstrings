    "Leave it empty to show the worktree folder's name.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以显示工作树文件夹名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以顯示工作樹資料夾名稱。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कट्री फ़ोल्डर का नाम दिखाने के लिए खाली छोड़ें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para mostrar el nombre de la carpeta del árbol de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour afficher le nom du dossier de l’arbre de travail."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ার্কট্রি ফোল্ডারের নাম দেখাতে খালি রাখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para mostrar o nome da pasta da árvore de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы показывать имя папки рабочего дерева."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄にするとワークツリーフォルダの名前を表示します。"
