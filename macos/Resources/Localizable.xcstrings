    "The project or backend connection changed. Cancel and reopen deletion to review the current project.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目或后端连接已更改。请取消并重新打开删除确认，查看当前项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案或後端連線已變更。請取消並重新開啟刪除確認，檢查目前的專案。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट या बैकएंड कनेक्शन बदल गया। रद्द करके हटाने का संवाद फिर खोलें और वर्तमान प्रोजेक्ट जाँचें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto o la conexión al backend cambió. Cancela y vuelve a abrir la eliminación para revisar el proyecto actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet ou la connexion au backend a changé. Annulez puis rouvrez la suppression pour vérifier le projet actuel."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকল্প বা ব্যাকএন্ড সংযোগ বদলেছে। বর্তমান প্রকল্প যাচাই করতে বাতিল করে মুছে ফেলার সংলাপ আবার খুলুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto ou a conexão com o backend mudou. Cancele e reabra a exclusão para revisar o projeto atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект или подключение к серверу изменились. Отмените и снова откройте удаление, чтобы проверить текущий проект."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトまたはバックエンド接続が変更されました。キャンセルして削除画面を開き直し、現在のプロジェクトを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 또는 백엔드 연결이 변경되었습니다. 취소한 후 삭제 창을 다시 열어 현재 프로젝트를 확인하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektet eller backendanslutningen har ändrats. Avbryt och öppna raderingen igen för att granska det aktuella projektet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto o la connessione al backend è cambiato. Annulla e riapri l’eliminazione per verificare il progetto attuale."
          }
        }
      }
    },
