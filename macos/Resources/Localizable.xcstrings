        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব প্যানেলে দেখা পৃষ্ঠার ইতিহাস মুছে যাবে। খোলা ট্যাব খোলাই থাকবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de todos os painéis será apagado. As abas abertas continuarão abertas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История посещений во всех панелях будет удалена. Открытые вкладки останутся открытыми."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのパネルの閲覧履歴を消去します。開いているタブはそのままです。"
