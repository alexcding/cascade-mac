    "Backend did not become ready. The port may be occupied. See %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端未就绪。端口可能已被占用。请查看 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端未就緒。連接埠可能已被占用。請查看 %@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकएंड तैयार नहीं हुआ। पोर्ट व्यस्त हो सकता है। %@ देखें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El backend no se preparó. Puede que el puerto esté ocupado. Consulta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le backend n’est pas prêt. Le port est peut-être occupé. Consultez %@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকএন্ড প্রস্তুত হয়নি। পোর্ট ব্যবহৃত হতে পারে। %@ দেখুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backend não ficou pronto. A porta pode estar ocupada. Consulte %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверная часть не готова. Возможно, порт занят. См. %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
