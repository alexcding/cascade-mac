    "Terminal geometry response ownership could not be configured." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টার্মিনালের জ্যামিতির প্রতিক্রিয়ার নিয়ন্ত্রণ কনফিগার করা যায়নি।"
