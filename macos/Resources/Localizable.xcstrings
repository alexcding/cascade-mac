    "On: runs and acts on real events. Try it with Dry Run first.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后会响应真实事件并执行操作。请先试用模拟运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後會回應真實事件並執行動作。請先試用模擬執行。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चालू होने पर वास्तविक घटनाओं पर काम करता है। पहले ड्राई रन करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activada: actúa sobre eventos reales. Prueba primero con una simulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activée : agit sur des événements réels. Essayez d’abord une simulation."
