            "value": "ワークフローを実行する前に、「設定 → 連携」で %@ のフックをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로를 실행하기 전에 설정 → 통합에서 %@ 훅을 설치하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera hookar för %@ i Inställningar → Integrationer innan du kör ett arbetsflöde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa gli hook di %@ in Impostazioni → Integrazioni prima di eseguire un flusso."
          }
        }
      }
    },
    "Completion analysis unavailable: %@. Continuing after the Stop hook.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法分析完成情况：%@。将在 Stop 钩子触发后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法分析完成狀態：%@。將在 Stop 掛鉤觸發後繼續。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्णता का विश्लेषण उपलब्ध नहीं: %@। Stop हुक के बाद आगे बढ़ रहे हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
