          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 터미널 연결에 새 클라이언트를 사용하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd en ny klient för varje terminalanslutning."
