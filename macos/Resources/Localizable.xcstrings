    "Unknown modifier “%@”; use shift, ctrl, alt, super or cmd.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知修饰键“%@”；请使用 shift、ctrl、alt、super 或 cmd。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未知修飾鍵「%@」；請使用 shift、ctrl、alt、super 或 cmd。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अज्ञात मॉडिफ़ायर “%@”; shift, ctrl, alt, super या cmd उपयोग करें।"
          }
        },
