          }
        }
      }
    },
    "The PTY helper did not preserve native color ownership. The created shell has been preserved." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY সহায়ক নেটিভ রঙের নিয়ন্ত্রণ রাখেনি। তৈরি করা শেল রাখা হয়েছে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El auxiliar PTY no conservó el control nativo de los colores. Se conservó el shell creado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’utilitaire PTY n’a pas conservé le contrôle natif des couleurs. Le shell créé est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY हेल्पर ने नेटिव रंग का स्वामित्व नहीं रखा। बनाया गया शेल सुरक्षित है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’helper PTY non ha conservato il controllo nativo dei colori. La shell creata è conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY ヘルパーがネイティブの色の管理権限を保持しませんでした。作成済みのシェルは保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY 도우미가 네이티브 색상 소유권을 유지하지 않았습니다. 생성된 셸은 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O auxiliar PTY não preservou o controle nativo de cores. O shell criado foi mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Помощник PTY не сохранил нативное управление цветами. Созданная оболочка сохранена."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY-hjälpprogrammet bevarade inte inbyggd färgkontroll. Det skapade skalet har behållits."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PTY 辅助程序未保留原生颜色控制权。已创建的 shell 已保留。"
