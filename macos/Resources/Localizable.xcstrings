        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নমুনার ওপর প্রতি ধাপের পরিকল্পনা করে। খোঁজ চলে; কিছু লেখা হয় না।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
