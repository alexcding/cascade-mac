    "No runs yet. They appear here once the automation is on and an event matches its trigger, or after Run for Real.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无运行记录。开启自动化并匹配触发事件后，或选择“实际运行”后，记录将出现在此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無執行紀錄。開啟自動化並符合觸發事件後，或選擇「實際執行」後，紀錄將出現在此處。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई रन नहीं। ऑटोमेशन चालू होने और ट्रिगर मेल खाने पर, या वास्तविक रन के बाद यहाँ दिखेंगे।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ejecuciones. Aparecen cuando está activada y un evento coincide, o tras Ejecutar de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune exécution. Elles apparaîtront après activation et correspondance d’un événement, ou après Exécuter réellement."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও চালনা নেই। অটোমেশন চালু ও ঘটনা ট্রিগারের সঙ্গে মিললে, অথবা বাস্তবে চালানোর পর এখানে দেখাবে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda sem execuções. Aparecem quando ativada e um evento corresponde ao gatilho, ou após Executar de verdade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запусков пока нет. Они появятся при включённой автоматизации и подходящем событии либо после реального запуска."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ実行履歴がありません。オンにしてトリガーに一致するイベントが発生するか、実際に実行すると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 실행 기록이 없습니다. 자동화를 켜고 이벤트가 트리거와 일치하거나 실제로 실행하면 여기에 표시됩니다."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga körningar ännu. De visas när automatiseringen är på och en händelse matchar utlösaren, eller efter Kör på riktigt."
          }
        },
        "it": {
