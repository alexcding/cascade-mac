    "Who opened the PR. @me is you, @bots is any bot account.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 的创建者。@me 表示你，@bots 表示任何机器人账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PR 的建立者。@me 代表你，@bots 代表任何機器人帳號。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PR खोलने वाला। @me आप हैं, @bots कोई भी बॉट खाता है।"
