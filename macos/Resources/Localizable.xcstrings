    "Terminal daemon protocol %lld is incompatible; expected 2.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端守护进程协议 %lld 不兼容；需要版本 2。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端機背景程序協定 %lld 不相容；需要版本 2。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल डेमन प्रोटोकॉल %lld असंगत है; संस्करण 2 अपेक्षित है।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El protocolo %lld del daemon del terminal es incompatible; se esperaba 2."
