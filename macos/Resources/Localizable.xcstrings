    "For example, App/App.xcworkspace. Leave blank to detect the Xcode target." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেমন App/App.xcworkspace। Xcode লক্ষ্য শনাক্ত করতে ফাঁকা রাখুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ejemplo, App/App.xcworkspace. Déjalo vacío para detectar el destino de Xcode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par exemple, App/App.xcworkspace. Laissez vide pour détecter la cible Xcode."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उदाहरण: App/App.xcworkspace। Xcode लक्ष्य स्वतः पहचानने के लिए खाली छोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ad esempio, App/App.xcworkspace. Lascia vuoto per rilevare la destinazione Xcode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：App/App.xcworkspace。空欄の場合、Xcode の対象を自動検出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: App/App.xcworkspace. 비워 두면 Xcode 대상을 감지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por exemplo, App/App.xcworkspace. Deixe em branco para detectar o destino do Xcode."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Например, App/App.xcworkspace. Оставьте пустым для определения цели Xcode."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Till exempel App/App.xcworkspace. Lämna tomt för att identifiera Xcode-målet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如 App/App.xcworkspace。留空以自动检测 Xcode 目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如 App/App.xcworkspace。留空以自動偵測 Xcode 目標。"
          }
        }
      }
