    "The backend did not confirm the commit. Refresh before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后端未确认提交。请刷新后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後端未確認提交。請重新整理後再試。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकएंड ने कमिट की पुष्टि नहीं की। फिर कोशिश से पहले रीफ़्रेश करें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El backend no confirmó el commit. Actualiza antes de reintentar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le backend n’a pas confirmé le commit. Actualisez avant de réessayer."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকএন্ড কমিট নিশ্চিত করেনি। আবার চেষ্টা করার আগে রিফ্রেশ করুন।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backend não confirmou o commit. Atualize antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер не подтвердил коммит. Обновите данные перед повторной попыткой."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミットが確認されませんでした。更新してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백엔드가 커밋을 확인하지 않았습니다. 새로 고친 후 다시 시도하세요."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Backend bekräftade inte incheckningen. Uppdatera innan du försöker igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backend non ha confermato il commit. Aggiorna prima di riprovare."
          }
        }
      }
    },
