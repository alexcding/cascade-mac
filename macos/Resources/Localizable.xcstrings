    "Pause new automatic runs. Automation modes are preserved.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停新的自动运行。保留各自动化的模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停新的自動執行。保留各自動化的模式。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए स्वचालित रन रोकें। ऑटोमेशन मोड सुरक्षित रहते हैं।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa nuevas ejecuciones automáticas. Se conservan los modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met en pause les nouvelles exécutions automatiques. Les modes sont conservés."
