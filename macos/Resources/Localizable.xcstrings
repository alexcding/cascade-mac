          "stringUnit" : {
            "state" : "translated",
            "value" : "El muestreo alcanzó el límite de 512 procesos; los totales son parciales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’échantillonnage a atteint la limite de 512 processus ; les totaux sont partiels."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नमूना 512 प्रक्रियाओं की सीमा तक पहुँच गया; कुल आंशिक हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il campionamento ha raggiunto il limite di 512 processi; i totali sono parziali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプリングが上限の512プロセスに達しました。合計は一部のみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샘플링이 프로세스 512개 한도에 도달했습니다. 합계는 일부만 반영합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A amostragem atingiu o limite de 512 processos; os totais são parciais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут предел измерения в 512 процессов; итоги неполные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mätningen nådde gränsen på 512 processer; summorna är ofullständiga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进程采样已达到 512 个进程的上限；总计为部分结果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "程序取樣已達 512 個程序的上限；總計為部分結果。"
          }
        }
      }
    },
