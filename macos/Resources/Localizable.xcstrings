    "Another agent turn started before the workflow step finished.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流步骤完成前，另一个代理轮次已开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流程步驟完成前，另一個代理程式回合已開始。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कफ़्लो चरण पूरा होने से पहले एजेंट का दूसरा टर्न शुरू हो गया।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzó otro turno del agente antes de terminar el paso del flujo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre tour de l’agent a commencé avant la fin de l’étape du workflow."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ার্কফ্লোর ধাপ শেষ হওয়ার আগে এজেন্টের আরেকটি পালা শুরু হয়েছে।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro turno do agente começou antes de a etapa do fluxo terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другой ход агента начался до завершения шага процесса."
          }
        },
        "ja": {
