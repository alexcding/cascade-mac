    "PR polling must be between 15 and 86400 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拉取请求刷新间隔必须为 15 至 86400 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提取要求重新整理間隔必須為 15 至 86400 秒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プルリクエストの更新間隔は15〜86400秒にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풀 리퀘스트 새로 고침 간격은 15~86400초여야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo de solicitudes debe estar entre 15 y 86400 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervalle des pull requests doit être compris entre 15 et 86400 secondes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo de pull requests deve ser de 15 a 86400 segundos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallet för pull requests måste vara mellan 15 och 86400 sekunder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intervallo delle pull request deve essere tra 15 e 86400 secondi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Интервал пул-реквестов должен быть от 15 до 86400 секунд."
