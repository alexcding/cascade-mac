    "Use your installed tools and existing sign-ins. Choose Shell only to work without an agent." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইনস্টল করা টুল ও বর্তমান সাইন-ইন ব্যবহার করুন। এজেন্ট ছাড়া কাজ করতে ‘শুধু Shell’ বেছে নিন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tus herramientas instaladas y las sesiones ya iniciadas. Elige Solo Shell para trabajar sin agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez vos outils installés et vos connexions existantes. Choisissez Shell uniquement pour travailler sans agent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंस्टॉल किए गए टूल और मौजूदा साइन-इन इस्तेमाल करें। एजेंट के बिना काम करने के लिए ‘केवल Shell’ चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa gli strumenti installati e gli accessi esistenti. Scegli Solo Shell per lavorare senza un agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みのツールと既存のサインインを使用します。エージェントを使わない場合は「Shell のみ」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치된 도구와 기존 로그인을 사용합니다. 에이전트 없이 작업하려면 ‘Shell만’을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use suas ferramentas instaladas e logins existentes. Escolha Somente Shell para trabalhar sem agente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работайте с установленными инструментами и существующими аккаунтами. Чтобы работать без агента, выберите «Только Shell»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
