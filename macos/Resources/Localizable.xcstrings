    "Open issues assigned to you appear beside your Jira tickets on the Dashboard." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনাকে অ্যাসাইন করা ওপেন issue ড্যাশবোর্ডে আপনার Jira টিকিটের পাশে দেখা যায়।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los issues abiertos asignados a ti aparecen junto a tus incidencias de Jira en el Panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les issues ouvertes qui vous sont assignées apparaissent à côté de vos tickets Jira dans le tableau de bord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको असाइन किए गए खुले issue डैशबोर्ड पर आपके Jira टिकटों के बगल में दिखते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le issue aperte assegnate a te compaiono accanto ai tuoi ticket Jira nella Panoramica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたに割り当てられた未解決の issue は、ダッシュボードの Jira チケットの横に表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나에게 할당된 열린 issue가 대시보드의 Jira 티켓 옆에 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As issues abertas atribuídas a você aparecem ao lado dos seus tickets do Jira no Painel."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытые issue, назначенные вам, отображаются рядом с вашими задачами Jira на панели управления."
          }
        },
