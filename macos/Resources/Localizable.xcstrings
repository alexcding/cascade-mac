    "Use {path} for the checkout. Quotes group arguments; shell expansion and pipelines are not supported.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 {path} 表示检出目录。引号可将参数分组；不支持 Shell 展开和管道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 {path} 表示簽出目錄。引號可將引數分組；不支援 Shell 展開與管線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックアウトの場所には {path} を使います。引用符で引数をまとめられます。シェル展開とパイプは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크아웃 경로에는 {path}를 사용하세요. 따옴표로 인수를 묶을 수 있습니다. 셸 확장과 파이프라인은 지원하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {path} para la carpeta de trabajo. Las comillas agrupan argumentos; no se admiten expansiones del shell ni tuberías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {path} pour le dossier de travail. Les guillemets regroupent les arguments ; les expansions du shell et les pipelines ne sont pas pris en charge."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {path} para a pasta de trabalho. Aspas agrupam argumentos; expansão do shell e pipelines não são suportados."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd {path} för arbetskopian. Citattecken grupperar argument; skalexpansion och pipelines stöds inte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa {path} per la cartella di lavoro. Le virgolette raggruppano gli argomenti; espansioni della shell e pipeline non sono supportate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {path} для рабочей копии. Кавычки группируют аргументы; подстановки оболочки и конвейеры не поддерживаются."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेकआउट के लिए {path} इस्तेमाल करें। उद्धरण चिह्न आर्ग्युमेंट को समूह में रखते हैं; शेल विस्तार और पाइपलाइन समर्थित नहीं हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চেকআউটের জন্য {path} ব্যবহার করুন। উদ্ধৃতি চিহ্ন আর্গুমেন্ট একত্র করে; শেল এক্সপ্যানশন ও পাইপলাইন সমর্থিত নয়।"
          }
        }
      }
    },
    "Remove all visited pages from history and address suggestions.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从历史记录和地址建议中移除所有已访问的页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從記錄與網址建議中移除所有曾造訪的網頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧済みのすべてのページを履歴とアドレス候補から削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문 기록과 주소 제안에서 방문한 모든 페이지를 제거합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita todas las páginas visitadas del historial y de las sugerencias de direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les pages visitées de l’historique et des suggestions d’adresses."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todas as páginas visitadas do histórico e das sugestões de endereço."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort alla besökta sidor från historiken och adressförslagen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutte le pagine visitate dalla cronologia e dai suggerimenti degli indirizzi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все посещённые страницы из истории и подсказок адреса."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतिहास और पते के सुझावों से सभी देखे गए पेज हटाएँ।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইতিহাস ও ঠিকানার পরামর্শ থেকে দেখা সব পৃষ্ঠা সরান।"
          }
        }
      }
    },
    "Remove cookies, caches, and site storage from Cascade’s browser. You will be signed out of websites.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Cascade 浏览器中的 Cookie、缓存和网站存储。你将退出网站登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Cascade 瀏覽器中的 Cookie、快取及網站儲存資料。你將登出網站。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade のブラウザから Cookie、キャッシュ、サイトの保存データを削除します。Web サイトからサインアウトされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade 브라우저의 쿠키, 캐시, 사이트 저장 데이터를 제거합니다. 웹사이트에서 로그아웃됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina cookies, cachés y almacenamiento de sitios del navegador de Cascade. Se cerrarán tus sesiones en los sitios web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les cookies, caches et données des sites du navigateur de Cascade. Vous serez déconnecté des sites web."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove cookies, caches e armazenamento de sites do navegador do Cascade. Você será desconectado dos sites."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort cookies, cache och webbplatslagring från Cascades webbläsare. Du loggas ut från webbplatser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove cookie, cache e dati dei siti dal browser di Cascade. Verrai disconnesso dai siti web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить cookie, кэш и данные сайтов из браузера Cascade. Будет выполнен выход из аккаунтов на сайтах."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade के ब्राउज़र से कुकी, कैश और साइट का स्टोरेज हटाएँ। वेबसाइटों से आपका साइन आउट हो जाएगा।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade-এর ব্রাউজার থেকে কুকি, ক্যাশ ও সাইটের স্টোরেজ সরান। ওয়েবসাইটগুলো থেকে আপনি সাইন আউট হয়ে যাবেন।"
          }
        }
      }
    },
    "Suspend the least recently used hidden page when browser memory exceeds this limit. Pages playing audio, using the camera or microphone, or downloading stay active.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器内存超过此上限时，暂停最久未使用的隐藏页面。正在播放音频、使用摄像头或麦克风以及下载的页面会保持运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器記憶體超過此上限時，暫停最久未使用的隱藏網頁。正在播放音訊、使用相機或麥克風，以及下載的網頁會保持執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのメモリが上限を超えると、非表示のページのうち最後に使ってから最も時間が経ったものを休止します。音声の再生中、カメラやマイクの使用中、ダウンロード中のページは維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 메모리가 한도를 넘으면 숨겨진 페이지 중 가장 오래 사용하지 않은 페이지를 일시 중단합니다. 오디오 재생, 카메라·마이크 사용, 다운로드 중인 페이지는 유지합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspende la página oculta que lleve más tiempo sin usarse cuando la memoria del navegador supere este límite. Las páginas que reproducen audio, usan la cámara o el micrófono, o descargan archivos siguen activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspend la page masquée inutilisée depuis le plus longtemps lorsque la mémoire du navigateur dépasse cette limite. Les pages diffusant de l’audio, utilisant la caméra ou le micro, ou téléchargeant des fichiers restent actives."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspende a página oculta sem uso há mais tempo quando a memória do navegador ultrapassa este limite. Páginas reproduzindo áudio, usando câmera ou microfone, ou baixando arquivos continuam ativas."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar den dolda sida som inte använts på längst tid när webbläsarens minne överstiger gränsen. Sidor som spelar ljud, använder kamera eller mikrofon eller hämtar filer hålls aktiva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospende la pagina nascosta inutilizzata da più tempo quando la memoria del browser supera questo limite. Le pagine che riproducono audio, usano fotocamera o microfono o scaricano file restano attive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда память браузера превышает лимит, приостановить скрытую страницу, которой дольше всего не пользовались. Страницы с воспроизведением звука, камерой, микрофоном или загрузками остаются активными."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र की मेमोरी सीमा पार होने पर सबसे लंबे समय से इस्तेमाल न हुए छिपे पेज को रोकें। ऑडियो चलाने, कैमरा या माइक्रोफ़ोन इस्तेमाल करने या डाउनलोड करने वाले पेज चलते रहते हैं।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্রাউজারের মেমরি এই সীমা ছাড়ালে সবচেয়ে বেশি সময় ধরে ব্যবহার না করা লুকানো পৃষ্ঠা স্থগিত করুন। অডিও চালানো, ক্যামেরা বা মাইক্রোফোন ব্যবহার করা কিংবা ডাউনলোড করা পৃষ্ঠা সক্রিয় থাকে।"
          }
        }
      }
    },
    "Choose how often Cascade checks GitHub and Jira for updates.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Cascade 检查 GitHub 和 Jira 更新的频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Cascade 檢查 GitHub 與 Jira 更新的頻率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub と Jira の更新を確認する頻度を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade가 GitHub와 Jira의 업데이트를 확인하는 주기를 선택하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige con qué frecuencia Cascade busca actualizaciones de GitHub y Jira."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la fréquence de vérification des mises à jour GitHub et Jira."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha com que frequência o Cascade verifica atualizações do GitHub e Jira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj hur ofta Cascade söker efter uppdateringar från GitHub och Jira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quanto spesso Cascade controlla gli aggiornamenti di GitHub e Jira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как часто Cascade проверяет обновления GitHub и Jira."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि Cascade कितनी बार GitHub और Jira के अपडेट जाँचे।"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Cascade কত ঘন ঘন GitHub ও Jira-র আপডেট দেখবে তা বেছে নিন।"
          }
        }
      }
    },
    "Seconds between PR refreshes. Minimum 15.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次拉取请求刷新之间的秒数，最少 15 秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩次提取要求重新整理之間的秒數，最少 15 秒。"
          }
        },
