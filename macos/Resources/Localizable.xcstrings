    "%@ is the branch this session forks from, so the main checkout cannot be moved off it. Choose a different “Branch from”." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সেশন %@ ব্রাঞ্চ থেকে তৈরি, তাই মূল চেকআউট সেখান থেকে সরানো যায় না। অন্য উৎস ব্রাঞ্চ বাছুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sesión parte de la rama %@, así que el checkout principal no puede salir de ella. Elige otra rama de origen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La session part de la branche %@ ; le checkout principal ne peut donc pas la quitter. Choisissez une autre branche source."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सत्र ब्रांच %@ से बनता है, इसलिए मुख्य चेकआउट उससे हट नहीं सकता। कोई दूसरी “स्रोत ब्रांच” चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sessione parte dal ramo %@, quindi il checkout principale non può abbandonarlo. Scegli un altro ramo di origine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションは %@ から分岐するため、メインのチェックアウトを別のブランチに移せません。別の分岐元を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션은 %@에서 분기하므로 기본 체크아웃을 해당 브랜치에서 옮길 수 없습니다. 다른 기준 브랜치를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão parte da branch %@, então o checkout principal não pode sair dela. Escolha outra branch de origem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сеанс создаётся от ветки %@, поэтому основную рабочую копию нельзя с неё переключить. Выберите другую исходную ветку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen förgrenas från %@, så huvudutcheckningen kan inte flyttas från den. Välj en annan ursprungsgren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此会话基于分支 %@，因此主检出无法切换到其他分支。请选择不同的“基于分支”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此工作階段以分支 %@ 為基礎，因此主簽出無法切換至其他分支。請選擇不同的「來源分支」。"
          }
        }
      }
    },
    "%@ isn't committed, so new worktrees won't have it. Commit it, or list it under Copy ignored files if git ignores it." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ কমিট করা হয়নি, তাই নতুন ওয়ার্কট্রিতে থাকবে না। কমিট করুন, অথবা Git উপেক্ষা করলে উপেক্ষিত ফাইল কপি করুন তালিকায় যোগ করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está confirmado y no aparecerá en nuevos árboles de trabajo. Confírmalo o añádelo a Copiar archivos ignorados si Git lo ignora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas commité et sera absent des nouveaux arbres de travail. Commitez-le ou ajoutez-le à Copier les fichiers ignorés si Git l’ignore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ कमिट नहीं हुआ है, इसलिए नए वर्कट्री में नहीं होगा। इसे कमिट करें, या Git द्वारा अनदेखा होने पर अनदेखी फ़ाइलें कॉपी करें में जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è stato committato e non sarà presente nei nuovi alberi di lavoro. Esegui il commit o aggiungilo a Copia file ignorati se Git lo ignora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はコミットされていないため、新しいワークツリーには含まれません。コミットするか、Git が無視するファイルなら「無視されたファイルをコピー」に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 커밋되지 않아 새 워크트리에 포함되지 않습니다. 커밋하거나 Git에서 무시하는 파일이면 무시된 파일 복사 목록에 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não foi commitado e não estará nas novas árvores de trabalho. Faça o commit ou inclua-o em Copiar arquivos ignorados se o Git o ignorar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не закоммичен и не попадёт в новые рабочие деревья. Сделайте коммит или добавьте файл в «Копировать игнорируемые файлы», если Git его игнорирует."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är inte incheckad och saknas därför i nya arbetsträd. Checka in filen eller ange den under Kopiera ignorerade filer om Git ignorerar den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未提交，因此新工作树不会包含它。请提交该文件；如果 Git 忽略它，请将其列在“复制忽略的文件”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 尚未提交，因此新工作樹不會包含它。請提交該檔案；若 Git 忽略它，請將其列在「複製忽略的檔案」中。"
          }
        }
      }
    },
    "%@ must include ⌘ to avoid interfering with terminal commands." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টার্মিনালের কমান্ডে ব্যাঘাত এড়াতে %@-এ ⌘ থাকতে হবে।"
          }
