    "The editor used to open session worktrees. Set a launch target in the project’s Settings tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সেশনের ওয়ার্কট্রি খোলার এডিটর। প্রকল্পের সেটিংস ট্যাবে লঞ্চ লক্ষ্য নির্ধারণ করুন।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El editor usado para abrir los árboles de trabajo de las sesiones. Define un destino de inicio en la pestaña Ajustes del proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’éditeur utilisé pour ouvrir les arbres de travail des sessions. Définissez une cible de lancement dans l’onglet Réglages du projet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सत्र के वर्कट्री खोलने के लिए उपयोग होने वाला एडिटर। प्रोजेक्ट के सेटिंग्स टैब में लॉन्च लक्ष्य सेट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’editor usato per aprire gli alberi di lavoro delle sessioni. Imposta una destinazione di avvio nella scheda Impostazioni del progetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションのワークツリーを開くエディタです。起動対象はプロジェクトの「設定」タブで指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션 워크트리를 여는 데 사용하는 편집기입니다. 프로젝트의 설정 탭에서 실행 대상을 지정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O editor usado para abrir as árvores de trabalho das sessões. Defina um destino de abertura na aba Ajustes do projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Редактор для открытия рабочих деревьев сеансов. Задайте цель запуска на вкладке настроек проекта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redigeraren som öppnar sessionernas arbetsträd. Ange ett startmål på projektets flik Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于打开会话工作树的编辑器。可在项目的“设置”标签页中设置启动目标。"
          }
        },
        "zh-Hant" : {
