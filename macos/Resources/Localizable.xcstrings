    "Suspend the least recently used hidden page when browser memory exceeds this limit. Pages playing audio, using the camera or microphone, or downloading stay active." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্রাউজারের মেমরি এই সীমা ছাড়ালে সবচেয়ে বেশি সময় ধরে ব্যবহার না করা লুকানো পৃষ্ঠা স্থগিত করুন। অডিও চালানো, ক্যামেরা বা মাইক্রোফোন ব্যবহার করা কিংবা ডাউনলোড করা পৃষ্ঠা সক্রিয় থাকে।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspende la página oculta que lleve más tiempo sin usarse cuando la memoria del navegador supere este límite. Las páginas que reproducen audio, usan la cámara o el micrófono, o descargan archivos siguen activas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspend la page masquée inutilisée depuis le plus longtemps lorsque la mémoire du navigateur dépasse cette limite. Les pages diffusant de l’audio, utilisant la caméra ou le micro, ou téléchargeant des fichiers restent actives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़र की मेमोरी सीमा पार होने पर सबसे लंबे समय से इस्तेमाल न हुए छिपे पेज को रोकें। ऑडियो चलाने, कैमरा या माइक्रोफ़ोन इस्तेमाल करने या डाउनलोड करने वाले पेज चलते रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sospende la pagina nascosta inutilizzata da più tempo quando la memoria del browser supera questo limite. Le pagine che riproducono audio, usano fotocamera o microfono o scaricano file restano attive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザのメモリが上限を超えると、非表示のページのうち最後に使ってから最も時間が経ったものを休止します。音声の再生中、カメラやマイクの使用中、ダウンロード中のページは維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저 메모리가 한도를 넘으면 숨겨진 페이지 중 가장 오래 사용하지 않은 페이지를 일시 중단합니다. 오디오 재생, 카메라·마이크 사용, 다운로드 중인 페이지는 유지합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspende a página oculta sem uso há mais tempo quando a memória do navegador ultrapassa este limite. Páginas reproduzindo áudio, usando câmera ou microfone, ou baixando arquivos continuam ativas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда память браузера превышает лимит, приостановить скрытую страницу, которой дольше всего не пользовались. Страницы с воспроизведением звука, камерой, микрофоном или загрузками остаются активными."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar den dolda sida som inte använts på längst tid när webbläsarens minne överstiger gränsen. Sidor som spelar ljud, använder kamera eller mikrofon eller hämtar filer hålls aktiva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览器内存超过此上限时，暂停最久未使用的隐藏页面。正在播放音频、使用摄像头或麦克风以及下载的页面会保持运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽器記憶體超過此上限時，暫停最久未使用的隱藏網頁。正在播放音訊、使用相機或麥克風，以及下載的網頁會保持執行。"
          }
        }
      }
    },
