    "Not requested. Cascade asks the first time a session needs the microphone." : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো অনুরোধ করা হয়নি। কোনো সেশনে প্রথম মাইক্রোফোন দরকার হলে Cascade অনুমতি চায়।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No solicitado. Cascade lo pide la primera vez que una sesión necesita el micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non demandé. Cascade demande l’autorisation la première fois qu’une session a besoin du micro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुरोध नहीं किया गया। सत्र को पहली बार माइक्रोफ़ोन चाहिए होने पर Cascade पूछता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non richiesto. Cascade chiede il permesso quando una sessione ha bisogno del microfono per la prima volta."
