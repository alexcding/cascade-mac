    "Plans every step against a sample. Lookups run; nothing is written.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "针对示例规划每个步骤。会执行查询，但不写入任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
